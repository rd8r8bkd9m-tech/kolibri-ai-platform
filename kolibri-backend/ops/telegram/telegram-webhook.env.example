# Install as root-owned mode 0600 at /etc/kolibri/telegram-webhook.env only
# after the owner-approved Bot API registration gate. Never commit real values.
KOLIBRI_TELEGRAM_WEBHOOK_ENABLED=false
KOLIBRI_TELEGRAM_OWNER_APPROVED=false
KOLIBRI_TELEGRAM_ALLOWED_CHAT_IDS=
KOLIBRI_PUBLIC_BASE_URL=https://kolibriai.ru
# Reject non-Telegram origins after the relay and Home proxy chain are
# configured. The relay's mesh address must be an explicit /32 here; loopback
# is trusted by the backend automatically.
KOLIBRI_TELEGRAM_REQUIRE_OFFICIAL_SOURCE=true
KOLIBRI_TELEGRAM_TRUSTED_PROXY_CIDRS=
# A channel is reported live only while persisted official-origin evidence is
# fresh. This is evidence lifetime, not a request execution timeout.
KOLIBRI_TELEGRAM_DELIVERY_EVIDENCE_MAX_AGE_SECONDS=86400
TELEGRAM_WEBHOOK_SECRET=
