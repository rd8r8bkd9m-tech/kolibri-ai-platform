[Unit]
Description=Kolibri P7 immutable backend @@RELEASE_ID@@
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@@RUNTIME_USER@@
Group=@@RUNTIME_GROUP@@
WorkingDirectory=@@BACKEND_DIR@@
EnvironmentFile=@@RUNTIME_SECRET_FILE@@
EnvironmentFile=-/etc/kolibri/codex-cli/proxy.env
EnvironmentFile=-/etc/kolibri/codex-cli.env
Environment=HOME=@@RUNTIME_HOME@@
Environment=KOLIBRI_RELEASE_ID=@@RELEASE_ID@@
Environment=KOLIBRI_CAPABILITY_PROBE_TTL_SECONDS=25200
Environment=DATABASE_URL=sqlite:///@@DATABASE_PATH@@
Environment=KOLIBRI_ARTIFACT_DIR=@@DATA_DIR@@/artifacts
Environment=XDG_CACHE_HOME=@@DATA_DIR@@/cache
Environment=TMPDIR=@@DATA_DIR@@/tmp
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=@@VENV_DIR@@/bin/python -B -m uvicorn app.main:app --host 127.0.0.1 --port @@BACKEND_PORT@@ --no-access-log
Restart=on-failure
RestartSec=2s
TimeoutStartSec=60s
TimeoutStopSec=30s
KillMode=mixed
UMask=0027
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=no
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=@@DATA_DIR@@ @@RUNTIME_HOME@@/.codex

[Install]
WantedBy=multi-user.target
