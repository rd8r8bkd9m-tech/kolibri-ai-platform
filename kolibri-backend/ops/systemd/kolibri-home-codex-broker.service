[Unit]
Description=Kolibri Home Codex factory provider broker
Wants=network-online.target kolibri-codex-http-proxy.service
After=network-online.target kolibri-codex-http-proxy.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=ladik
Group=ladik
WorkingDirectory=/opt/kolibri-ai/canary-r9/backend

# Home is the sole task authority.  The broker contract rejects legacy
# main/primary endpoints even if an operator attempts to override this value.
EnvironmentFile=/etc/kolibri/home-control-plane.env
Environment=HOME=/home/ladik
Environment=CODEX_HOME=/home/ladik/.codex
Environment=CODEX_CLI_ENABLED=true
Environment=CODEX_CLI_BINARY=/usr/local/bin/codex
Environment=CODEX_CLI_CWD=/var/lib/kolibri/home-codex-broker/work
Environment=CODEX_CLI_RESPECT_SYSTEM_PROXY=true
Environment=CODEX_CLI_MAX_CONCURRENCY=1
Environment=CODEX_CLI_QUEUE_TIMEOUT_SECONDS=30
Environment=CODEX_CLI_ATTEMPT_TIMEOUT_SECONDS=3600
Environment=CODEX_CLI_HEALTH_TIMEOUT_SECONDS=12
Environment=KOLIBRI_HOME_CODEX_BROKER_ARTIFACT_ROOT=/var/lib/kolibri/home-codex-broker/artifacts
Environment=KOLIBRI_HOME_CODEX_BROKER_HEARTBEAT_SECONDS=10
Environment=KOLIBRI_HOME_CODEX_BROKER_HEALTH_REFRESH_SECONDS=15
Environment=KOLIBRI_HOME_CODEX_BROKER_RETRY_INITIAL_SECONDS=1
Environment=KOLIBRI_HOME_CODEX_BROKER_RETRY_MAX_SECONDS=30
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=TMPDIR=/var/lib/kolibri/home-codex-broker/tmp
EnvironmentFile=-/etc/kolibri/codex-cli/proxy.env
UnsetEnvironment=OPENAI_API_KEY ANTHROPIC_API_KEY TELEGRAM_BOT_TOKEN

# The existing owner Codex CLI session is read in place.  It is never copied
# into the release tree, an EnvironmentFile, or another node.
ExecStart=/opt/kolibri-ai/canary-r9/backend/.venv/bin/python -B -m app.home_factory_orchestrator
Restart=always
RestartSec=3s
TimeoutStartSec=45s
TimeoutStopSec=45s
KillMode=mixed
UMask=0077

StateDirectory=kolibri/home-codex-broker
StateDirectoryMode=0700
RuntimeDirectory=kolibri/home-codex-broker
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=no
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/kolibri/home-codex-broker /home/ladik/.codex

[Install]
WantedBy=multi-user.target
