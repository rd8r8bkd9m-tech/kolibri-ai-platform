[Unit]
Description=Kolibri localhost HTTP CONNECT proxy for Codex CLI
Documentation=file:/etc/kolibri/codex-cli/README.md
Requires=kolibri-codex-egress.service
After=kolibri-codex-egress.service

[Service]
Type=simple
ExecStartPre=/usr/bin/test -r /etc/kolibri/codex-cli/3proxy-egress.cfg
ExecStart=/usr/bin/3proxy /etc/kolibri/codex-cli/3proxy-egress.cfg
Restart=always
RestartSec=3s
TimeoutStartSec=15s
TimeoutStopSec=10s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
