# Stateless Telegram webhook ingress for relay 78.17.4.108.
#
# Render and validate this file with telegram_relayctl.py. This virtual host
# intentionally exposes exactly one application route. It contains no Bot API
# token and does not terminate or enqueue work locally.

upstream kolibri_home_telegram_webhook {
    server __HOME_MESH_IP__:443;
    keepalive 8;
}

server {
    listen 78.17.4.108:443 ssl;
    server_name kolibriai.ru;

    ssl_certificate __FULLCHAIN_PATH__;
    ssl_certificate_key __PRIVKEY_PATH__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:KolibriTelegramRelay:10m;
    ssl_session_timeout 10m;
    server_tokens off;

    access_log /var/log/nginx/kolibriai-telegram-relay.access.log;
    error_log /var/log/nginx/kolibriai-telegram-relay.error.log warn;

    client_max_body_size 1m;

    location = /api/v1/telegram/webhook {
        # Telegram's official webhook ranges. Re-check the primary Telegram
        # webhook documentation before every deployment wave.
        allow 149.154.160.0/20;
        allow 91.108.4.0/22;
        deny all;

        limit_except POST {
            deny all;
        }

        proxy_pass https://kolibri_home_telegram_webhook;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_ssl_name kolibriai.ru;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 3;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_ssl_session_reuse on;

        proxy_set_header Host kolibriai.ru;
        proxy_set_header X-Telegram-Bot-Api-Secret-Token $http_x_telegram_bot_api_secret_token;
        # Overwrite, do not append, so a public client cannot spoof the first
        # hop. Home nginx appends this relay's mesh address.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";

        proxy_connect_timeout 5s;
        proxy_send_timeout 15s;
        proxy_read_timeout 55s;
        proxy_next_upstream off;
        proxy_buffering off;
        proxy_request_buffering on;
        proxy_redirect off;
    }

    location / {
        return 404;
    }
}
