# Kolibri Backend Configuration
# Copy to .env and configure for your environment

# Database
DATABASE_URL=sqlite:///./kolibri.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/kolibri

# JWT
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production
TOKEN_EXPIRE_MINUTES=1440

# AI Providers — Kimi Proxy CFBT (custom OpenAI-compatible proxy, NOT official Kimi)
KIMI_CFBT_BASE_URL=https://cfbt.ccwu.cc/v1
KIMI_CFBT_API_KEY=
KIMI_CFBT_MODEL=@cf/moonshotai/kimi-k2.6

# AI Providers — Official Kimi API (platform.kimi.ai)
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.7-code

# AI Provider timeout
AI_TIMEOUT=60

# Telegram webhook receiver (disabled until an owner-approved protected
# activation bundle is installed on Home). Never commit the bot token, webhook
# secret or owner chat identifiers.
KOLIBRI_TELEGRAM_WEBHOOK_ENABLED=false
KOLIBRI_TELEGRAM_OWNER_APPROVED=false
KOLIBRI_TELEGRAM_ALLOWED_CHAT_IDS=
KOLIBRI_PUBLIC_BASE_URL=https://kolibriai.ru
TELEGRAM_WEBHOOK_SECRET=

# Server
HOST=0.0.0.0
PORT=8000
