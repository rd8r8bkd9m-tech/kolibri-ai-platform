# Kolibri Backend Configuration
# Copy to .env and configure for your environment

# Database
DATABASE_URL=sqlite:///./kolibri.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/kolibri

# JWT
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production
KOLIBRI_EVIDENCE_SIGNING_KEY=generate-a-dedicated-random-secret-with-at-least-32-bytes
KOLIBRI_PROJECT_HANDOFF_SECRET=generate-a-dedicated-random-secret-with-at-least-32-bytes
TOKEN_EXPIRE_MINUTES=1440

# AI Providers — Kimi Proxy CFBT (custom OpenAI-compatible proxy, NOT official Kimi)
KIMI_CFBT_BASE_URL=https://cfbt.ccwu.cc/v1
KIMI_CFBT_API_KEY=
KIMI_CFBT_MODEL=@cf/moonshotai/kimi-k2.6

# AI Providers — Official Kimi API (platform.kimi.ai)
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.7-code

# AI Provider timeout
AI_TIMEOUT=60

# Telegram webhook receiver (disabled until an owner-approved protected
# activation bundle is installed on Home). Never commit the bot token, webhook
# secret or owner chat identifiers.
KOLIBRI_TELEGRAM_WEBHOOK_ENABLED=false
KOLIBRI_TELEGRAM_OWNER_APPROVED=false
KOLIBRI_TELEGRAM_ALLOWED_CHAT_IDS=
KOLIBRI_PUBLIC_BASE_URL=https://kolibriai.ru
TELEGRAM_WEBHOOK_SECRET=

# Server
HOST=0.0.0.0
PORT=8000

# Release identity returned on every HTTP response and by /api/health.
KOLIBRI_RELEASE_ID=unversioned
# Successful capability probes are owned by this exact release and remain
# fresh through the six-hour campaign plus the initial one-hour soak. A new
# release starts unproved and must perform its own real invocations.
KOLIBRI_CAPABILITY_PROBE_TTL_SECONDS=25200

# Public OpenAI-compatible API. Store only SHA-256 values, never plaintext
# keys. Runtime-created developer keys are persisted hash-only in the DB.
KOLIBRI_PUBLIC_API_KEY_SHA256=
# Owner token hash required by /api/v1/developer/api-keys lifecycle routes.
KOLIBRI_OWNER_API_ADMIN_TOKEN_SHA256=
