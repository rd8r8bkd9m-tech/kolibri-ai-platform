<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.kolibri.us-socks-tunnel</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/ssh</string>
    <string>-N</string>
    <string>-D</string>
    <string>127.0.0.1:1088</string>
    <string>-o</string>
    <string>ExitOnForwardFailure=yes</string>
    <string>-o</string>
    <string>ServerAliveInterval=30</string>
    <string>-o</string>
    <string>ServerAliveCountMax=3</string>
    <string>root@45.39.33.252</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/kolibri/Documents/Codex/kolibri-ai-platform/.factory/logs/us-socks-tunnel.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/kolibri/Documents/Codex/kolibri-ai-platform/.factory/logs/us-socks-tunnel.err</string>
</dict>
</plist>
