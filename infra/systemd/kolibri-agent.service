[Unit]
Description=Kolibri Agent Service (Code Execution + Planning)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/kolibri-ai/network
Environment=KOLIBRI_AGENT_PORT=8003
Environment=KOLIBRI_INFERENCE_URL=http://10.99.0.5:8001
ExecStart=/usr/bin/python3 -m uvicorn agent_service:app --host 0.0.0.0 --port 8003
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
