{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.kolibriai.ru/v1/common/trace.schema.json",
  "title": "Kolibri trace context v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["trace_id", "span_id", "parent_span_id", "correlation_id", "causation_id"],
  "properties": {
    "trace_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "span_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "parent_span_id": {
      "oneOf": [
        {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        {"type": "null"}
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160
    },
    "causation_id": {
      "oneOf": [
        {"type": "string", "minLength": 8, "maxLength": 160},
        {"type": "null"}
      ]
    }
  }
}
