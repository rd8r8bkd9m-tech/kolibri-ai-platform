{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.kolibriai.ru/v1/common/command-envelope.schema.json",
  "title": "Kolibri command envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "message_id",
    "command_name",
    "payload_schema_id",
    "payload_schema_version",
    "issued_at",
    "deadline_at",
    "target_owner",
    "identity",
    "trace",
    "idempotency",
    "payload"
  ],
  "properties": {
    "schema_id": {"const": "kolibri.command"},
    "schema_version": {"const": "1.0"},
    "message_id": {
      "type": "string",
      "pattern": "^cmd_[A-Za-z0-9][A-Za-z0-9._~-]{7,127}$"
    },
    "command_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "maxLength": 160
    },
    "payload_schema_id": {
      "type": "string",
      "pattern": "^kolibri\\.[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+\\.command$",
      "maxLength": 200
    },
    "payload_schema_version": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.[0-9]+$",
      "maxLength": 20
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "deadline_at": {"type": "string", "format": "date-time"},
    "target_owner": {
      "type": "string",
      "enum": [
        "logical_home_control_plane",
        "product_data_authority",
        "provider_execution_authority"
      ]
    },
    "identity": {
      "$ref": "https://schemas.kolibriai.ru/v1/common/identity.schema.json"
    },
    "trace": {
      "$ref": "https://schemas.kolibriai.ru/v1/common/trace.schema.json"
    },
    "idempotency": {
      "$ref": "https://schemas.kolibriai.ru/v1/common/idempotency.schema.json"
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "idempotency": {
            "properties": {"scope": {"const": "goal"}},
            "required": ["scope"]
          }
        },
        "required": ["idempotency"]
      },
      "then": {
        "properties": {
          "identity": {
            "properties": {
              "subject_refs": {
                "properties": {"goal_id": {"type": "string"}}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "idempotency": {
            "properties": {"scope": {"const": "case"}},
            "required": ["scope"]
          }
        },
        "required": ["idempotency"]
      },
      "then": {
        "properties": {
          "identity": {
            "properties": {
              "subject_refs": {
                "properties": {"case_id": {"type": "string"}}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "idempotency": {
            "properties": {"scope": {"const": "task"}},
            "required": ["scope"]
          }
        },
        "required": ["idempotency"]
      },
      "then": {
        "properties": {
          "identity": {
            "properties": {
              "subject_refs": {
                "properties": {"task_id": {"type": "string"}}
              }
            }
          }
        }
      }
    }
  ]
}
