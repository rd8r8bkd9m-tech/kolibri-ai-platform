{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.kolibriai.ru/v1/documents/document-template-registry.schema.json",
  "title": "Kolibri document template registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "registry_id",
    "generated_at",
    "templates"
  ],
  "properties": {
    "schema_id": {
      "const": "kolibri.document_template_registry"
    },
    "schema_version": {
      "const": "1.0"
    },
    "registry_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64,
      "pattern": "^[a-z0-9_\\-]+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "template_id",
          "template_version",
          "document_type",
          "locale",
          "jurisdictions",
          "output_formats",
          "layout_fingerprint",
          "render_enabled"
        ],
        "properties": {
          "template_id": {
            "type": "string",
            "pattern": "^[a-z0-9_\\-]+\\.v[0-9]+$"
          },
          "template_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?$"
          },
          "document_type": {
            "type": "string",
            "enum": [
              "commercial_offer",
              "contract",
              "completion_act",
              "invoice"
            ]
          },
          "locale": {
            "type": "string",
            "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"
          },
          "jurisdictions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            }
          },
          "output_formats": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": ["pdf", "docx", "xlsx"]
            }
          },
          "layout_fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "render_enabled": {
            "type": "boolean"
          }
        }
      },
      "uniqueItems": true
    }
  }
}
