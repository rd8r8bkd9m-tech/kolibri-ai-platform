{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.kolibriai.ru/v1/cases/decision.schema.json",
  "title": "Kolibri ProjectCase decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "question",
    "alternatives",
    "selected_option",
    "selected_proposal_id",
    "evidence_refs",
    "authority_decision_id",
    "made_by_actor_id",
    "effective_case_version",
    "consequences",
    "decided_at",
    "supersedes_decision_id"
  ],
  "properties": {
    "decision_id": {"$ref": "#/definitions/opaque_id"},
    "question": {"type": "string", "minLength": 1, "maxLength": 2000},
    "alternatives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "selected_option": {"type": "string", "minLength": 1, "maxLength": 1000},
    "selected_proposal_id": {
      "oneOf": [
        {"$ref": "#/definitions/opaque_id"},
        {"type": "null"}
      ]
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/opaque_id"}
    },
    "authority_decision_id": {"$ref": "#/definitions/opaque_id"},
    "made_by_actor_id": {"$ref": "#/definitions/opaque_id"},
    "effective_case_version": {"type": "integer", "minimum": 1},
    "consequences": {
      "type": "array",
      "maxItems": 100,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "decided_at": {"type": "string", "format": "date-time"},
    "supersedes_decision_id": {
      "oneOf": [
        {"$ref": "#/definitions/opaque_id"},
        {"type": "null"}
      ]
    }
  },
  "definitions": {
    "opaque_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[A-Za-z0-9][A-Za-z0-9._~-]{5,127}$"
    }
  }
}
