{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.kolibriai.ru/v1/cases/proposal.schema.json",
  "title": "Kolibri ProjectCase proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_id",
    "question",
    "option",
    "rationale",
    "evidence_refs",
    "status",
    "created_by_actor_id",
    "created_at"
  ],
  "properties": {
    "proposal_id": {"$ref": "#/definitions/opaque_id"},
    "question": {"type": "string", "minLength": 1, "maxLength": 2000},
    "option": {"type": "string", "minLength": 1, "maxLength": 2000},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 2000},
    "evidence_refs": {
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/opaque_id"}
    },
    "status": {
      "type": "string",
      "enum": ["open", "selected", "rejected", "superseded"]
    },
    "created_by_actor_id": {"$ref": "#/definitions/opaque_id"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "definitions": {
    "opaque_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[A-Za-z0-9][A-Za-z0-9._~-]{5,127}$"
    }
  }
}
