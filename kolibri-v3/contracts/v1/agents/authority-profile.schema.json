{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.kolibriai.ru/v1/agents/authority-profile.schema.json",
  "title": "Kolibri AssignmentAuthorityProfile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authority_id",
    "authority_role",
    "authority_epoch",
    "authorization_decision_id",
    "capabilities",
    "allowed_tool_ids",
    "allowed_resource_refs",
    "expires_at"
  ],
  "properties": {
    "authority_id": { "$ref": "#/definitions/opaque_id" },
    "authority_role": {
      "const": "logical_home_control_plane"
    },
    "authority_epoch": { "type": "integer", "minimum": 1 },
    "authorization_decision_id": { "$ref": "#/definitions/opaque_id" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.:-]{2,127}$"
      }
    },
    "allowed_tool_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.:-]{2,127}$"
      }
    },
    "allowed_resource_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/opaque_id" }
    },
    "expires_at": { "type": "string", "format": "date-time" }
  },
  "definitions": {
    "opaque_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[A-Za-z0-9][A-Za-z0-9._~-]{5,127}$"
    }
  }
}
