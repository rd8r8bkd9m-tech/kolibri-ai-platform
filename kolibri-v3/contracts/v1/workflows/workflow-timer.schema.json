{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.kolibriai.ru/v1/workflows/workflow-timer.schema.json",
  "title": "Kolibri Project Workflow timer v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "workflow_id",
    "timer_id",
    "timer_type",
    "scheduled_at",
    "status"
  ],
  "properties": {
    "schema_id": { "const": "kolibri.workflow.timer" },
    "schema_version": { "const": "1.0" },
    "workflow_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[A-Za-z0-9][A-Za-z0-9._~-]{5,127}$"
    },
    "timer_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[A-Za-z0-9][A-Za-z0-9._~-]{5,127}$"
    },
    "timer_type": {
      "type": "string",
      "enum": ["lease_expiry", "retry_backoff", "deadline_policy", "poll_interval"]
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["waiting", "fired", "cancelled", "rescheduled"]
    },
    "fired_at": {
      "oneOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    }
  }
}
