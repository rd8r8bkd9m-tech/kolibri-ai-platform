{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.kolibriai.ru/v1/workflows/workflow-version.schema.json",
  "title": "Kolibri Project Workflow version command v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "workflow_id",
    "expected_version",
    "next_version",
    "reason",
    "requested_at"
  ],
  "properties": {
    "schema_id": { "const": "kolibri.workflow.version.transition.command" },
    "schema_version": { "const": "1.0" },
    "workflow_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[A-Za-z0-9][A-Za-z0-9._~-]{5,127}$"
    },
    "expected_version": {
      "type": "integer",
      "minimum": 1
    },
    "next_version": {
      "type": "integer",
      "minimum": 2
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
