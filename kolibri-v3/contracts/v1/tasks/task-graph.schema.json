{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.kolibriai.ru/v1/tasks/task-graph.schema.json",
  "title": "Kolibri TaskGraph read model v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "graph_id",
    "tenant_id",
    "goal_id",
    "case_id",
    "graph_version",
    "tasks",
    "relations",
    "topological_task_ids",
    "runnable_task_ids",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_id": { "const": "kolibri.task_graph" },
    "schema_version": { "const": "1.0" },
    "graph_id": { "$ref": "#/definitions/opaque_id" },
    "tenant_id": { "$ref": "#/definitions/opaque_id" },
    "goal_id": { "$ref": "#/definitions/opaque_id" },
    "case_id": { "$ref": "#/definitions/opaque_id" },
    "graph_version": { "type": "integer", "minimum": 1 },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "https://schemas.kolibriai.ru/v1/tasks/task.schema.json"
      }
    },
    "relations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "parent_task_id",
          "child_task_ids",
          "dependency_task_ids",
          "dependent_task_ids",
          "blocked_by_task_ids",
          "runnable"
        ],
        "properties": {
          "task_id": { "$ref": "#/definitions/opaque_id" },
          "parent_task_id": {
            "oneOf": [
              { "$ref": "#/definitions/opaque_id" },
              { "type": "null" }
            ]
          },
          "child_task_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/definitions/opaque_id" }
          },
          "dependency_task_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/definitions/opaque_id" }
          },
          "dependent_task_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/definitions/opaque_id" }
          },
          "blocked_by_task_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/definitions/opaque_id" }
          },
          "runnable": { "type": "boolean" }
        }
      }
    },
    "topological_task_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/opaque_id" }
    },
    "runnable_task_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/opaque_id" }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "definitions": {
    "opaque_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[A-Za-z0-9][A-Za-z0-9._~-]{5,127}$"
    }
  }
}
