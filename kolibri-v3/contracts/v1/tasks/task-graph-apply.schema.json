{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.kolibriai.ru/v1/tasks/task-graph-apply.schema.json",
  "title": "Kolibri TaskGraph apply command payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "graph_id",
    "tenant_id",
    "goal_id",
    "case_id",
    "expected_graph_version",
    "next_graph_version",
    "tasks",
    "reason",
    "requested_at"
  ],
  "properties": {
    "schema_id": { "const": "kolibri.task_graph.apply.command" },
    "schema_version": { "const": "1.0" },
    "graph_id": { "$ref": "#/definitions/opaque_id" },
    "tenant_id": { "$ref": "#/definitions/opaque_id" },
    "goal_id": { "$ref": "#/definitions/opaque_id" },
    "case_id": { "$ref": "#/definitions/opaque_id" },
    "expected_graph_version": { "type": "integer", "minimum": 0 },
    "next_graph_version": { "type": "integer", "minimum": 1 },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "https://schemas.kolibriai.ru/v1/tasks/task.schema.json"
      }
    },
    "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "requested_at": { "type": "string", "format": "date-time" }
  },
  "definitions": {
    "opaque_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[A-Za-z0-9][A-Za-z0-9._~-]{5,127}$"
    }
  }
}
