{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.kolibriai.ru/v1/quality/finding.schema.json",
  "title": "Kolibri Review Finding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id",
    "severity",
    "category",
    "statement",
    "artifact_locator",
    "evidence_refs",
    "required_action",
    "owner_ref",
    "status",
    "resolution"
  ],
  "properties": {
    "finding_id": { "$ref": "#/definitions/opaque_id" },
    "severity": {
      "type": "string",
      "enum": ["info", "low", "medium", "high", "critical"]
    },
    "category": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{2,127}$"
    },
    "statement": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "artifact_locator": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/versioned_ref" }
    },
    "required_action": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "owner_ref": { "$ref": "#/definitions/opaque_id" },
    "status": {
      "type": "string",
      "enum": ["open", "accepted_risk", "resolved", "superseded"]
    },
    "resolution": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["disposition", "resolved_by", "resolved_at", "evidence_refs"],
          "properties": {
            "disposition": {
              "type": "string",
              "enum": ["fixed", "not_reproducible", "accepted_risk", "superseded"]
            },
            "resolved_by": { "$ref": "#/definitions/opaque_id" },
            "resolved_at": { "type": "string", "format": "date-time" },
            "evidence_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/definitions/versioned_ref" }
            }
          }
        },
        { "type": "null" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "enum": ["resolved", "accepted_risk"] } },
        "required": ["status"]
      },
      "then": { "properties": { "resolution": { "type": "object" } } }
    },
    {
      "if": {
        "properties": { "status": { "const": "open" } },
        "required": ["status"]
      },
      "then": { "properties": { "resolution": { "type": "null" } } }
    }
  ],
  "definitions": {
    "opaque_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[A-Za-z0-9][A-Za-z0-9._~-]{5,127}$"
    },
    "versioned_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref_id", "version"],
      "properties": {
        "ref_id": { "$ref": "#/definitions/opaque_id" },
        "version": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
