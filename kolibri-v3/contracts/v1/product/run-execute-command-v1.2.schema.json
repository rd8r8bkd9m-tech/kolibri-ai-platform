{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.kolibriai.ru/v1/product/run-execute-command-v1.2.schema.json",
  "title": "Kolibri Product developer run execute command payload v1.2",
  "description": "Server-frozen universal AgentRuntime request. The runtime profile is opaque to Product/Data and no provider-specific routing semantics are encoded here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "tenant_id",
    "project_id",
    "thread_id",
    "run_id",
    "input_message_id",
    "case_id",
    "goal_id",
    "prompt",
    "prompt_hash",
    "execution_mode",
    "runtime_profile",
    "model",
    "reasoning_effort",
    "service_tier",
    "workspace_ref",
    "access_mode",
    "sandbox",
    "approval_policy",
    "reviewer",
    "requester_role"
  ],
  "properties": {
    "schema_id": {
      "const": "kolibri.product.run.execute.v1_2.command"
    },
    "schema_version": {
      "const": "1.2"
    },
    "tenant_id": {
      "$ref": "#/definitions/opaque_id"
    },
    "project_id": {
      "$ref": "#/definitions/opaque_id"
    },
    "thread_id": {
      "$ref": "#/definitions/opaque_id"
    },
    "run_id": {
      "$ref": "#/definitions/opaque_id"
    },
    "input_message_id": {
      "$ref": "#/definitions/opaque_id"
    },
    "case_id": {
      "$ref": "#/definitions/opaque_id"
    },
    "goal_id": {
      "$ref": "#/definitions/opaque_id"
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200000
    },
    "prompt_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "execution_mode": {
      "const": "developer"
    },
    "runtime_profile": {
      "$ref": "#/definitions/runtime_profile"
    },
    "model": {
      "oneOf": [
        {
          "$ref": "#/definitions/model_selection"
        },
        {
          "type": "null"
        }
      ]
    },
    "reasoning_effort": {
      "oneOf": [
        {
          "$ref": "#/definitions/execution_option"
        },
        {
          "type": "null"
        }
      ]
    },
    "service_tier": {
      "oneOf": [
        {
          "$ref": "#/definitions/execution_option"
        },
        {
          "type": "null"
        }
      ]
    },
    "workspace_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
    },
    "access_mode": {
      "type": "string",
      "enum": [
        "auto",
        "full"
      ]
    },
    "sandbox": {
      "type": "string",
      "enum": [
        "workspace-write",
        "danger-full-access"
      ]
    },
    "approval_policy": {
      "type": "string",
      "enum": [
        "on-request",
        "never"
      ]
    },
    "reviewer": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "requester_role": {
      "const": "owner"
    }
  },
  "definitions": {
    "opaque_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[A-Za-z0-9][A-Za-z0-9._~-]{5,127}$"
    },
    "runtime_profile": {
      "type": "string",
      "minLength": 2,
      "maxLength": 96,
      "pattern": "^[a-z0-9][a-z0-9._-]{1,95}$"
    },
    "model_selection": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
    },
    "execution_option": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
    }
  }
}
