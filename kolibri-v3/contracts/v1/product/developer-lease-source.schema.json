{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.kolibriai.ru/v1/product/developer-lease-source.schema.json",
  "title": "Kolibri Product developer lease source v1",
  "description": "The exact command hashes, assignment and Home lease fence forwarded to Provider Execution Authority. The source command is transported separately.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "source_command_ref",
    "canonical_request_hash",
    "source_command_hash",
    "tenant_id",
    "task_id",
    "task_version",
    "attempt_id",
    "assignment_id",
    "effect_id",
    "lease_id",
    "fencing_token",
    "runtime_profile",
    "access_policy"
  ],
  "properties": {
    "schema_id": {
      "const": "kolibri.product.developer_lease_source"
    },
    "schema_version": {
      "const": "1.0"
    },
    "source_command_ref": {
      "$ref": "#/definitions/source_command_ref"
    },
    "canonical_request_hash": {
      "$ref": "#/definitions/sha256"
    },
    "source_command_hash": {
      "$ref": "#/definitions/sha256"
    },
    "tenant_id": {
      "$ref": "#/definitions/opaque_id"
    },
    "task_id": {
      "$ref": "#/definitions/opaque_id"
    },
    "task_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "attempt_id": {
      "$ref": "#/definitions/opaque_id"
    },
    "assignment_id": {
      "$ref": "#/definitions/opaque_id"
    },
    "effect_id": {
      "type": "string",
      "pattern": "^effect_[0-9a-f]{40}$"
    },
    "lease_id": {
      "$ref": "#/definitions/opaque_id"
    },
    "fencing_token": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "runtime_profile": {
      "$ref": "#/definitions/runtime_profile"
    },
    "access_policy": {
      "$ref": "#/definitions/access_policy"
    }
  },
  "definitions": {
    "opaque_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[A-Za-z0-9][A-Za-z0-9._~-]{5,127}$"
    },
    "source_command_ref": {
      "type": "string",
      "pattern": "^sourcecmd_[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "runtime_profile": {
      "type": "string",
      "minLength": 2,
      "maxLength": 96,
      "pattern": "^[a-z0-9][a-z0-9._-]{1,95}$"
    },
    "access_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "tool_ids",
        "compute_units_limit",
        "tool_calls_limit"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{2,127}$"
        },
        "tool_ids": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.:-]{2,127}$"
          }
        },
        "compute_units_limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tool_calls_limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
