{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.kolibriai.ru/v1/product/message.schema.json",
  "title": "Kolibri Product Message v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "tenant_id",
    "project_id",
    "thread_id",
    "message_id",
    "sequence",
    "parent_message_id",
    "branch_id",
    "run_id",
    "role",
    "author_actor_id",
    "status",
    "parts",
    "version",
    "created_at",
    "committed_at"
  ],
  "properties": {
    "schema_id": { "const": "kolibri.product.message" },
    "schema_version": { "const": "1.0" },
    "tenant_id": { "$ref": "#/definitions/opaque_id" },
    "project_id": { "$ref": "#/definitions/opaque_id" },
    "thread_id": { "$ref": "#/definitions/opaque_id" },
    "message_id": { "$ref": "#/definitions/opaque_id" },
    "sequence": { "type": "integer", "minimum": 1 },
    "parent_message_id": {
      "oneOf": [
        { "$ref": "#/definitions/opaque_id" },
        { "type": "null" }
      ]
    },
    "branch_id": { "$ref": "#/definitions/opaque_id" },
    "run_id": {
      "oneOf": [
        { "$ref": "#/definitions/opaque_id" },
        { "type": "null" }
      ]
    },
    "role": {
      "type": "string",
      "enum": ["user", "assistant", "system"]
    },
    "author_actor_id": { "$ref": "#/definitions/opaque_id" },
    "status": {
      "type": "string",
      "enum": ["committed", "superseded", "redacted"]
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "https://schemas.kolibriai.ru/v1/product/message-part.schema.json"
      }
    },
    "version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "committed_at": { "type": "string", "format": "date-time" }
  },
  "definitions": {
    "opaque_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[A-Za-z0-9][A-Za-z0-9._~-]{5,127}$"
    }
  }
}
