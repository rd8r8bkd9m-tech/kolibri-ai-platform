{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.kolibriai.ru/v1/product/session.schema.json",
  "title": "Kolibri Product session v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "tenant_id",
    "user_id",
    "session_kind",
    "expires_at",
    "product_api_version",
    "capabilities"
  ],
  "properties": {
    "schema_id": {
      "const": "kolibri.product.session"
    },
    "schema_version": {
      "const": "1.0"
    },
    "tenant_id": {
      "$ref": "#/definitions/opaque_id"
    },
    "user_id": {
      "$ref": "#/definitions/opaque_id"
    },
    "session_kind": {
      "type": "string",
      "enum": [
        "anonymous",
        "authenticated"
      ]
    },
    "expires_at": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "product_api_version": {
      "const": "v1"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.:-]{2,127}$"
      }
    }
  },
  "definitions": {
    "opaque_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[A-Za-z0-9][A-Za-z0-9._~-]{5,127}$"
    }
  }
}
