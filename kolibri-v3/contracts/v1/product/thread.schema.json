{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.kolibriai.ru/v1/product/thread.schema.json",
  "title": "Kolibri Product Thread v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "tenant_id",
    "project_id",
    "thread_id",
    "title",
    "status",
    "branch_count",
    "last_message_sequence",
    "last_run_sequence",
    "version",
    "created_by",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_id": { "const": "kolibri.product.thread" },
    "schema_version": { "const": "1.0" },
    "tenant_id": { "$ref": "#/definitions/opaque_id" },
    "project_id": { "$ref": "#/definitions/opaque_id" },
    "thread_id": { "$ref": "#/definitions/opaque_id" },
    "title": { "type": "string", "minLength": 1, "maxLength": 240 },
    "status": {
      "type": "string",
      "enum": ["active", "archived", "deleted"]
    },
    "branch_count": { "type": "integer", "minimum": 1 },
    "last_message_sequence": { "type": "integer", "minimum": 0 },
    "last_run_sequence": { "type": "integer", "minimum": 0 },
    "version": { "type": "integer", "minimum": 1 },
    "created_by": { "$ref": "#/definitions/opaque_id" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "definitions": {
    "opaque_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[A-Za-z0-9][A-Za-z0-9._~-]{5,127}$"
    }
  }
}
