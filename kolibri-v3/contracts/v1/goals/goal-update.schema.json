{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.kolibriai.ru/v1/goals/goal-update.schema.json",
  "title": "Kolibri Goal update command payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "goal_id",
    "expected_version",
    "next_version",
    "goal",
    "reason",
    "requested_at"
  ],
  "properties": {
    "schema_id": { "const": "kolibri.goal.update.command" },
    "schema_version": { "const": "1.0" },
    "goal_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9_]{1,31}_[A-Za-z0-9][A-Za-z0-9._~-]{5,127}$"
    },
    "expected_version": { "type": "integer", "minimum": 1 },
    "next_version": { "type": "integer", "minimum": 2 },
    "goal": {
      "$ref": "https://schemas.kolibriai.ru/v1/goals/goal.schema.json"
    },
    "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "requested_at": { "type": "string", "format": "date-time" }
  }
}
