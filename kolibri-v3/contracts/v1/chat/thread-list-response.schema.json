{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kolibriai.ru/v3/contracts/v1/chat/thread-list-response.schema.json",
  "title": "Kolibri V3 tenant thread list response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "threads",
    "nextCursor"
  ],
  "properties": {
    "threads": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/thread"
      }
    },
    "nextCursor": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{7,159}$"
    },
    "thread": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "projectId",
        "title",
        "status",
        "pinned",
        "createdAt",
        "updatedAt",
        "lastMessageAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/opaqueId"
        },
        "projectId": {
          "$ref": "#/$defs/opaqueId"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "status": {
          "type": "string",
          "enum": [
            "regular",
            "archived"
          ]
        },
        "pinned": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastMessageAt": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
