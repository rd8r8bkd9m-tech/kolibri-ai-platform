{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kolibriai.ru/v3/contracts/v1/chat/message-list-response.schema.json",
  "title": "Kolibri V3 tenant thread messages response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "threadId",
    "messages",
    "nextCursor"
  ],
  "properties": {
    "threadId": {
      "$ref": "#/$defs/opaqueId"
    },
    "messages": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/message"
      }
    },
    "nextCursor": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{7,159}$"
    },
    "textPart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "const": "text"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "content",
        "createdAt",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/opaqueId"
        },
        "role": {
          "type": "string",
          "enum": [
            "user",
            "assistant"
          ]
        },
        "content": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/textPart"
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "reason"
          ],
          "properties": {
            "type": {
              "const": "complete"
            },
            "reason": {
              "const": "stop"
            }
          }
        }
      }
    }
  }
}
