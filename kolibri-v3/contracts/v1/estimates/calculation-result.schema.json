{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kolibriai.ru/contracts/v1/estimates/calculation-result.schema.json",
  "title": "Kolibri estimate calculation result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "engineVersion",
    "calculationId",
    "currency",
    "rulesVersion",
    "roundingPolicy",
    "lines",
    "totals",
    "validation"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "engineVersion": {
      "type": "string",
      "const": "kolibri-estimate-kernel/0.1.0"
    },
    "calculationId": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "rulesVersion": {
      "type": "string"
    },
    "roundingPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "moneyScale",
        "quantityScale",
        "midpoint"
      ],
      "properties": {
        "moneyScale": {
          "const": 2
        },
        "quantityScale": {
          "const": 6
        },
        "midpoint": {
          "const": "away_from_zero"
        }
      }
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "title",
          "unit",
          "normalizedQuantity",
          "unitPrice",
          "subtotal",
          "priceStatus",
          "sourceId"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "enum": [
              "work",
              "material",
              "equipment",
              "service",
              "delivery",
              "other"
            ]
          },
          "title": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "normalizedQuantity": {
            "$ref": "#/$defs/decimal"
          },
          "unitPrice": {
            "oneOf": [
              {
                "$ref": "#/$defs/decimal"
              },
              {
                "type": "null"
              }
            ]
          },
          "subtotal": {
            "oneOf": [
              {
                "$ref": "#/$defs/decimal"
              },
              {
                "type": "null"
              }
            ]
          },
          "priceStatus": {
            "enum": [
              "missing",
              "preliminary",
              "source_backed",
              "verified"
            ]
          },
          "sourceId": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byCategory",
        "directCost",
        "overhead",
        "profit",
        "discount",
        "tax",
        "total",
        "complete"
      ],
      "properties": {
        "byCategory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "work",
            "material",
            "equipment",
            "service",
            "delivery",
            "other"
          ],
          "properties": {
            "work": {
              "$ref": "#/$defs/decimal"
            },
            "material": {
              "$ref": "#/$defs/decimal"
            },
            "equipment": {
              "$ref": "#/$defs/decimal"
            },
            "service": {
              "$ref": "#/$defs/decimal"
            },
            "delivery": {
              "$ref": "#/$defs/decimal"
            },
            "other": {
              "$ref": "#/$defs/decimal"
            }
          }
        },
        "directCost": {
          "$ref": "#/$defs/decimal"
        },
        "overhead": {
          "$ref": "#/$defs/decimal"
        },
        "profit": {
          "$ref": "#/$defs/decimal"
        },
        "discount": {
          "$ref": "#/$defs/decimal"
        },
        "tax": {
          "$ref": "#/$defs/decimal"
        },
        "total": {
          "$ref": "#/$defs/decimal"
        },
        "complete": {
          "type": "boolean"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "missingPriceLineIds",
        "preliminaryPriceLineIds"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "blocked"
          ]
        },
        "missingPriceLineIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preliminaryPriceLineIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    }
  }
}

