# Server-only URL of the new isolated Kolibri V3 backend.
# Plain HTTP is accepted only for loopback development.
KOLIBRI_V3_BACKEND_URL=http://127.0.0.1:8002

# V3 backend runtime.
KOLIBRI_V3_DATABASE_URL=sqlite:///./var/kolibri-v3.db
KOLIBRI_V3_ALLOWED_ORIGINS=http://127.0.0.1:3103,http://localhost:3103
KOLIBRI_V3_COOKIE_SECURE=false
KOLIBRI_V3_ENV=development

# User-triggered read-only FGIS CS lookup. Production defaults to false until
# source-owner/legal terms review is recorded and the release owner enables it.
KOLIBRI_V3_FGIS_PRICING_ENABLED=true

# Direct loopback model execution. The backend owns one persistent Codex
# app-server for its full lifespan; a model request never starts `codex exec`.
# gpt-5.5/low is compatible with Codex CLI 0.142.5 and can be overridden after
# a verified CLI upgrade. Production keeps this disabled and executes on the
# isolated Provider Execution Authority.
KOLIBRI_V3_DIRECT_MODEL_RUNTIME=true
KOLIBRI_V3_DIRECT_MODEL_TIMEOUT_SECONDS=180
KOLIBRI_V3_CODEX_MODEL=gpt-5.5
KOLIBRI_V3_CODEX_EFFORT=low

# Owner-only repository agent for loopback development. The server derives
# authority from the HttpOnly session and constrains Codex to this workspace.
# Production rejects this local adapter and must route execution through the
# Provider Execution Authority described in the control-plane documentation.
KOLIBRI_V3_DEVELOPER_AGENT_ENABLED=true
KOLIBRI_V3_DEVELOPER_WORKSPACE_ROOT=/absolute/path/to/kolibri-ai-platform
KOLIBRI_V3_DEVELOPER_AGENT_TIMEOUT_SECONDS=1800

# Production must set a stable secret. The bootstrap email constrains the
# trusted server-side owner command; public registration never grants a role.
KOLIBRI_V3_CSRF_SECRET=
KOLIBRI_V3_BOOTSTRAP_OWNER_EMAIL=

# Durable model execution. The V3 worker talks only to Logical Home; it never
# calls MiMo, Codex CLI, the Primary gateway, or a physical node directly.
KOLIBRI_V3_HOME_PRODUCT_COMMAND_URL=
# Optional; defaults to the same origin plus the fixed Goal initialization path.
KOLIBRI_V3_HOME_PRODUCT_GOAL_COMMAND_URL=
KOLIBRI_V3_HOME_PRODUCT_COMMAND_TOKEN_FILE=
KOLIBRI_V3_HOME_PRODUCT_IDENTITY_HMAC_KEY_FILE=
# Local compatibility only for the current factory control. Production uses 2.
KOLIBRI_V3_HOME_PRODUCT_IDENTITY_PROOF_VERSION=2
KOLIBRI_V3_HOME_PRODUCT_REQUEST_TIMEOUT_SECONDS=10
KOLIBRI_V3_HOME_PRODUCT_MAX_RESPONSE_BYTES=524288

# Versioned Product/Data authority grant. Logical Home verifies these values
# against its own server configuration; browser input can never change them.
KOLIBRI_V3_PRODUCT_AUTHORITY_ID=authority_product_data_v1
KOLIBRI_V3_PRODUCT_AUTHORITY_EPOCH=1
KOLIBRI_V3_PRODUCT_AUTHORITY_PLACEMENT_ID=placement_product_backend
KOLIBRI_V3_PRODUCT_AUTHORIZATION_DECISION_ID=decision_product_data_v1
KOLIBRI_V3_PRODUCT_AUTHORITY_CAPABILITIES=product.goal.initialize.request,product.run.execute.request,product.provider.enrollment.request

# Worker timing. The exact stored command is replayed while Home reports
# accepted/running; a browser disconnect never cancels the durable run.
KOLIBRI_V3_PRODUCT_RUN_REQUEST_TIMEOUT_SECONDS=10
KOLIBRI_V3_PRODUCT_RUN_LEASE_SECONDS=30
KOLIBRI_V3_PRODUCT_RUN_POLL_SECONDS=0.5
KOLIBRI_V3_PRODUCT_RUN_RETRY_BASE_SECONDS=1
KOLIBRI_V3_PRODUCT_RUN_RETRY_MAX_SECONDS=60
KOLIBRI_V3_PRODUCT_RUN_IDLE_SECONDS=0.25
KOLIBRI_V3_PRODUCT_RUN_MAX_ATTEMPTS=8
KOLIBRI_V3_PRODUCT_RUN_COMMAND_DEADLINE_SECONDS=900

# Secretless provider enrollment dispatcher. The browser and Next BFF only
# call the V3 Product/Data backend. Enable this gate only when the standalone
# worker and exact Primary responder are supervised. These credentials
# authenticate Product/Data to Primary; they are not MiMo/Codex credentials.
KOLIBRI_V3_PROVIDER_AUTHORITY_DISPATCH_CONFIGURED=false
KOLIBRI_V3_PROVIDER_AUTHORITY_COMMAND_URL=
KOLIBRI_V3_PROVIDER_AUTHORITY_COMMAND_TOKEN_FILE=
KOLIBRI_V3_PROVIDER_AUTHORITY_IDENTITY_HMAC_KEY_FILE=
KOLIBRI_V3_PROVIDER_AUTHORITY_IDENTITY_KEY_ID=key_provider_enrollment_v1
KOLIBRI_V3_PROVIDER_AUTHORITY_REQUEST_TIMEOUT_SECONDS=10
KOLIBRI_V3_PROVIDER_AUTHORITY_MAX_RESPONSE_BYTES=65536
KOLIBRI_V3_PROVIDER_ENROLLMENT_MAX_ATTEMPTS=8
KOLIBRI_V3_PROVIDER_ENROLLMENT_COMMAND_DEADLINE_SECONDS=900
KOLIBRI_V3_PROVIDER_ENROLLMENT_LEASE_SECONDS=30
KOLIBRI_V3_PROVIDER_ENROLLMENT_RETRY_BASE_SECONDS=2
KOLIBRI_V3_PROVIDER_ENROLLMENT_RETRY_MAX_SECONDS=300
KOLIBRI_V3_PROVIDER_ENROLLMENT_IDLE_SECONDS=0.5
KOLIBRI_V3_PROVIDER_ENROLLMENT_REAUTH_SECONDS=900

# Loopback development writes the MiMo key to this private CLI credential file.
# A production runtime may read an already-provisioned tenant-bound vault only
# when the explicit read-only gate below is enabled. Production API routes
# still cannot install or replace provider credentials.
KOLIBRI_V3_LOCAL_MIMO_AUTH_PATH=
KOLIBRI_V3_LOCAL_PROVIDER_VAULT_READ_ENABLED=false
KOLIBRI_V3_MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
# AES-256-GCM master key for the provider vault. Development may create it;
# production only opens an existing root/service-owned mode-0600 file.
KOLIBRI_V3_PROVIDER_ENCRYPTION_KEY_FILE=
# Optional fixed path for the private loopback CSRF secret. When omitted,
# development creates a mode-0600 file beside the SQLite database.
KOLIBRI_V3_CSRF_SECRET_FILE=
