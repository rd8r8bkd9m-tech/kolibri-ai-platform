# Шаблон окружения. Скопируйте в .env и заполните значения.
# .env в репозиторий не коммитится.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Production: postgresql://user:password@host:5432/coli_db
# Local SQLite (dev only): file:./db/dev.db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/coli_db"

# ---------------------------------------------------------------------------
# JWT Secrets (обязательно замените в production!)
# Генерация: openssl rand -hex 32
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=your-access-secret-here-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-here-min-32-chars

# ---------------------------------------------------------------------------
# GigaChat API (Sber)
# Docs: https://developers.sber.ru/docs/ru/gigachat/quickstart/ind-using-api
# Authorization Key: Studio → Settings API → «Получить ключ»
# ---------------------------------------------------------------------------
GIGA_CHAT_AUTH_KEY=
# Альтернатива — пара ключей вместо одного Authorization Key:
# GIGA_CHAT_API_KEY=
# GIGA_CHAT_API_SECRET=

# ---------------------------------------------------------------------------
# Access passwords (вход по паролю, без регистрации)
# ---------------------------------------------------------------------------
# Пароль администратора: даёт доступ к /admin/*
COLI_ADMIN_PASSWORD=
# Пароль пользователя (опционально): гостевой вход с ролью user
# COLI_USER_PASSWORD=

# ---------------------------------------------------------------------------
# Push-уведомления (VAPID ключи)
# Генерация: npx web-push generate-vapid-keys
# Docs: https://github.com/web-push-libs/web-push
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Levels: debug, info, warn, error, fatal
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# ---------------------------------------------------------------------------
# Subscription / Billing
# ---------------------------------------------------------------------------
YOOKASSA_STORE_API_KEY=
YOOKASSA_TEST_STORE_API_KEY=
YOOKASSA_SECRET=
YOOKASSA_SHOP_ID=

# ---------------------------------------------------------------------------
# Monitoring
# ---------------------------------------------------------------------------
# Prometheus metrics port (separate from app port)
METRICS_PORT=9090

# ---------------------------------------------------------------------------
# Z.AI (опционально, платформенная интеграция)
# ---------------------------------------------------------------------------
Z_AI_API_KEY=

# ---------------------------------------------------------------------------
# PDF Generation (опционально)
# ---------------------------------------------------------------------------
# HTML2PDF_SCRIPT=/path/to/scripts/html2pdf-next.js
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# ---------------------------------------------------------------------------
# Analytics (Яндекс.Метрика)
# ---------------------------------------------------------------------------
# Docs: https://yandex.ru/support/metrika/
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# ---------------------------------------------------------------------------
# Sentry (error tracking & performance monitoring)
# ---------------------------------------------------------------------------
# Docs: https://docs.sentry.io/platforms/javascript/guides/nextjs/
# Get DSN: https://sentry.com/settings/<org>/projects/
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_RELEASE=
