[Unit]
Description=Kolibri V3 frontend
Wants=network-online.target
After=network-online.target kolibri-v3-backend.service

[Service]
Type=simple
User=ladik
Group=ladik
Environment=HOME=/home/ladik
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3103
Environment=KOLIBRI_V3_BACKEND_URL=http://127.0.0.1:8002
WorkingDirectory=/opt/kolibri-v3/current/frontend
ExecStart=/usr/bin/node /opt/kolibri-v3/current/frontend/server.js
Restart=always
RestartSec=3s
TimeoutStartSec=60s
TimeoutStopSec=30s
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
