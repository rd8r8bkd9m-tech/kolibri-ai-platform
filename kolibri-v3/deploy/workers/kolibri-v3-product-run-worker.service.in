[Unit]
Description=Kolibri V3 Product/Data outbox worker
Requires=@BACKEND_SERVICE@
Wants=network-online.target
After=network-online.target @BACKEND_SERVICE@
PartOf=@BACKEND_SERVICE@
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
EnvironmentFile=@CONFIG_ROOT@/backend.env
EnvironmentFile=@CONFIG_ROOT@/release.env
EnvironmentFile=@CONFIG_ROOT@/workers.env
LoadCredential=home-product-command-token:@CONFIG_ROOT@/credentials/home-product-command-token
LoadCredential=home-product-identity-hmac-key:@CONFIG_ROOT@/credentials/home-product-identity-hmac-key
Environment=KOLIBRI_WORKER_CREDENTIAL_DIRECTORY=/run/@INSTANCE@-product-run-worker
Environment=KOLIBRI_V3_HOME_PRODUCT_COMMAND_TOKEN_FILE=/run/@INSTANCE@-product-run-worker/home-product-command-token
Environment=KOLIBRI_V3_HOME_PRODUCT_IDENTITY_HMAC_KEY_FILE=/run/@INSTANCE@-product-run-worker/home-product-identity-hmac-key
Environment=KOLIBRI_WORKER_EXPECTED_DATABASE_URL=sqlite:///@INSTALL_ROOT@/var/kolibri-v3.db
Environment=KOLIBRI_WORKER_LOCK_PATH=/run/@INSTANCE@-product-run-worker/owner.lock
Environment=HOME=/nonexistent
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=@INSTALL_ROOT@/current/backend
ExecStartPre=@INSTALL_ROOT@/current/backend/venv/bin/python @INSTALL_ROOT@/libexec/worker_launcher.py product-run --materialize-credentials
ExecStartPre=@INSTALL_ROOT@/current/backend/venv/bin/python @INSTALL_ROOT@/libexec/worker_launcher.py product-run --check
ExecStart=@INSTALL_ROOT@/current/backend/venv/bin/python @INSTALL_ROOT@/libexec/worker_launcher.py product-run
Restart=on-failure
RestartPreventExitStatus=73 75 78
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=45s
KillSignal=SIGTERM
KillMode=mixed
RuntimeDirectory=@INSTANCE@-product-run-worker
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=@INSTALL_ROOT@/var /run/@INSTANCE@-product-run-worker
ReadOnlyPaths=@INSTALL_ROOT@/current @INSTALL_ROOT@/libexec @CONFIG_ROOT@

[Install]
WantedBy=@BACKEND_SERVICE@
