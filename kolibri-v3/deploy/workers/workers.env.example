# Non-secret worker dispatch configuration.
#
# Copy to /etc/kolibri-v3/workers.env with mode 0600, then replace every blank
# required value. Blank values are intentional: the launcher must fail closed
# until the exact Logical Home / Provider Authority endpoints are known.
#
# Transport secrets do not belong in this file. The systemd units load them as
# credentials from /etc/kolibri-v3/credentials/.

KOLIBRI_V3_HOME_PRODUCT_COMMAND_URL=
KOLIBRI_V3_HOME_PRODUCT_GOAL_COMMAND_URL=
KOLIBRI_V3_HOME_PRODUCT_PROVIDER_COMMAND_URL=
KOLIBRI_V3_HOME_PRODUCT_IDENTITY_KEY_ID=key_product_v3_v1
KOLIBRI_V3_HOME_PRODUCT_REQUEST_TIMEOUT_SECONDS=10
KOLIBRI_V3_HOME_PRODUCT_MAX_RESPONSE_BYTES=524288

KOLIBRI_V3_PROVIDER_AUTHORITY_DISPATCH_CONFIGURED=false
KOLIBRI_V3_PROVIDER_AUTHORITY_COMMAND_URL=
KOLIBRI_V3_PROVIDER_AUTHORITY_IDENTITY_KEY_ID=key_provider_enrollment_v1
KOLIBRI_V3_PROVIDER_AUTHORITY_REQUEST_TIMEOUT_SECONDS=10
KOLIBRI_V3_PROVIDER_AUTHORITY_MAX_RESPONSE_BYTES=65536
