[Unit]
Description=Kolibri V3 backend
Wants=network-online.target
After=network-online.target kolibri-mimo-code.service

[Service]
Type=simple
User=ladik
Group=ladik
Environment=HOME=/home/ladik
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/kolibri-v3/backend.env
Environment=KOLIBRI_V3_ENV=production
Environment=KOLIBRI_V3_DATABASE_URL=sqlite:////opt/kolibri-v3/var/kolibri-v3.db
Environment=KOLIBRI_V3_ALLOWED_ORIGINS=https://kolibriai.ru
Environment=KOLIBRI_V3_COOKIE_SECURE=true
Environment=KOLIBRI_V3_PRODUCT_AUTHORITY_ID=authority_product_data_v1
Environment=KOLIBRI_V3_PRODUCT_AUTHORITY_EPOCH=1
Environment=KOLIBRI_V3_PRODUCT_AUTHORITY_PLACEMENT_ID=placement_product_backend
Environment=KOLIBRI_V3_PRODUCT_AUTHORIZATION_DECISION_ID=decision_product_data_v1
Environment=KOLIBRI_V3_DIRECT_MODEL_RUNTIME=true
Environment=KOLIBRI_V3_DEVELOPER_AGENT_ENABLED=false
Environment=KOLIBRI_V3_MIMO_BASE_URL=http://127.0.0.1:39231
Environment=KOLIBRI_V3_MIMO_CLI_PATH=/usr/local/bin/mimo
WorkingDirectory=/opt/kolibri-v3/current/backend
ExecStart=/opt/kolibri-v3/current/backend/venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8002
Restart=always
RestartSec=3s
TimeoutStartSec=60s
TimeoutStopSec=30s
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
