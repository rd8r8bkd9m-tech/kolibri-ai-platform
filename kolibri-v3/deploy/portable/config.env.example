# Unique deployment identity. It is used for service, lock, config, and Nginx names.
KOLIBRI_INSTANCE=kolibri-v3

# Existing non-root Linux account that owns and runs this instance.
KOLIBRI_SERVICE_USER=kolibri

# Persistent installation and data directories.
KOLIBRI_INSTALL_ROOT=/opt/kolibri-v3
KOLIBRI_CONFIG_ROOT=/etc/kolibri-v3
KOLIBRI_BACKUP_ROOT=/var/backups/kolibri-v3

# Loopback-only application ports. Pick unique values for every Kolibri instance.
KOLIBRI_BACKEND_PORT=8002
KOLIBRI_FRONTEND_PORT=3103

# Public origin. Set KOLIBRI_ENABLE_NGINX=false when another reverse proxy is used.
KOLIBRI_DOMAIN=example.com
KOLIBRI_PUBLIC_SCHEME=https
KOLIBRI_ENABLE_NGINX=true
KOLIBRI_NGINX_SITE=/etc/nginx/sites-enabled/kolibri-v3.conf
KOLIBRI_TLS_CERTIFICATE=/etc/letsencrypt/live/example.com/fullchain.pem
KOLIBRI_TLS_CERTIFICATE_KEY=/etc/letsencrypt/live/example.com/privkey.pem

# Agent runtime host gates. Credentials are never copied into a release;
# authenticate this exact service account before installation. These settings
# only run host preflight. Runtime feature flags and workspace configuration
# remain operator-owned in /etc/kolibri-v3/backend.env. The embedded developer
# adapter must remain disabled in production; developer work runs through the
# Home/Provider worker plane into Kolibri's own isolated Agent Host. The owner
# may configure a trusted-agent profile with danger-full-access and
# approval=never there; that profile never runs inside the public V3 backend.
KOLIBRI_DIRECT_MODEL_RUNTIME=true
KOLIBRI_CODEX_BIN=/usr/local/bin/codex
KOLIBRI_REQUIRE_MIMO=true
KOLIBRI_MIMO_BASE_URL=http://127.0.0.1:39231
KOLIBRI_MIMO_CLI_PATH=/usr/local/bin/mimo

# Release gates run before the active symlink or services are changed.
KOLIBRI_RUN_FRONTEND_TESTS=true
KOLIBRI_HEALTH_TIMEOUT_SECONDS=90

# The Product worker is mandatory for the production chat/developer execution
# boundary. Installation fails closed when it is disabled or its root-owned
# mode-0600 workers.env / credential files are incomplete.
KOLIBRI_ENABLE_PRODUCT_WORKER=true
# Provider enrollment remains optional until that authority is connected.
KOLIBRI_ENABLE_PROVIDER_WORKER=false
