{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kolibriai.ru/contracts/kolibri-os-v1/control-plane.schema.json",
  "title": "Kolibri Home Control Plane compatibility contract",
  "description": "Machine-readable task, lease, fencing, completion, verifier and worker observation contract implemented by ops/factory_control.py and ops/agent_host.py.",
  "x-kolibri-authority": "control-plane/home",
  "x-kolibri-authority-mode": "single-fail-closed",
  "x-kolibri-forbidden-authority-identities": ["main", "primary", "primary-candidate"],
  "x-kolibri-runtime-sources": ["ops/factory_control.py", "ops/agent_host.py"],
  "oneOf": [
    { "$ref": "#/$defs/Task" },
    { "$ref": "#/$defs/TaskAttempt" },
    { "$ref": "#/$defs/TaskCompletionEvidence" },
    { "$ref": "#/$defs/TaskCompletionVerifier" },
    { "$ref": "#/$defs/NodeRecord" }
  ],
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "TaskState": {
      "enum": [
        "queued",
        "leased",
        "running",
        "waiting_review",
        "review",
        "completed",
        "failed",
        "cancelled",
        "retry_scheduled",
        "dead_letter"
      ]
    },
    "LeaseFencing": {
      "type": "object",
      "required": ["attempt_id", "fencing_token", "node_id", "agent_id"],
      "properties": {
        "attempt_id": { "$ref": "#/$defs/Identifier" },
        "fencing_token": { "type": "integer", "minimum": 1 },
        "node_id": { "$ref": "#/$defs/Identifier" },
        "agent_id": { "$ref": "#/$defs/Identifier" }
      },
      "additionalProperties": true,
      "x-kolibri-binding-rule": "all four fields must equal the active Home-issued lease; stale or missing values return HTTP 409"
    },
    "TaskAttempt": {
      "type": "object",
      "required": [
        "task_id",
        "attempt",
        "attempt_id",
        "lease_fencing_schema",
        "fencing_token",
        "lease_owner",
        "lease_until",
        "heartbeat_at"
      ],
      "properties": {
        "task_id": { "$ref": "#/$defs/Identifier" },
        "attempt": { "type": "integer", "minimum": 1 },
        "attempt_id": { "$ref": "#/$defs/Identifier" },
        "lease_fencing_schema": { "const": "kolibri.lease-fencing.v1" },
        "fencing_token": { "type": "integer", "minimum": 1 },
        "lease_owner": {
          "type": "string",
          "pattern": "^[^:\\s]+:[^:\\s]+$"
        },
        "lease_until": { "type": "number", "exclusiveMinimum": 0 },
        "heartbeat_at": { "$ref": "#/$defs/Timestamp" }
      },
      "additionalProperties": false,
      "x-kolibri-authority": "control-plane/home"
    },
    "CompletionChecks": {
      "type": "object",
      "required": [
        "task",
        "result",
        "attempt",
        "node",
        "agent",
        "status",
        "result_reference",
        "result_sha256",
        "binding_sha256",
        "fencing_token"
      ],
      "properties": {
        "task": { "type": "boolean" },
        "result": { "type": "boolean" },
        "attempt": { "type": "boolean" },
        "node": { "type": "boolean" },
        "agent": { "type": "boolean" },
        "status": { "type": "boolean" },
        "result_reference": { "type": "boolean" },
        "result_sha256": { "type": "boolean" },
        "binding_sha256": { "type": "boolean" },
        "fencing_token": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "TaskCompletionEvidence": {
      "type": "object",
      "required": [
        "schema_version",
        "task_id",
        "attempt_id",
        "fencing_token",
        "lease_owner",
        "node_id",
        "agent_id",
        "result_reference",
        "result_sha256",
        "binding_sha256"
      ],
      "properties": {
        "schema_version": { "const": "kolibri.task-completion-evidence.v1" },
        "task_id": { "$ref": "#/$defs/Identifier" },
        "attempt_id": { "$ref": "#/$defs/Identifier" },
        "fencing_token": { "type": "integer", "minimum": 1 },
        "lease_owner": { "type": "string", "minLength": 3 },
        "node_id": { "$ref": "#/$defs/Identifier" },
        "agent_id": { "$ref": "#/$defs/Identifier" },
        "result_reference": { "type": "string", "minLength": 1 },
        "result_sha256": { "$ref": "#/$defs/Sha256" },
        "binding_sha256": { "$ref": "#/$defs/Sha256" }
      },
      "additionalProperties": false
    },
    "TaskCompletionVerifier": {
      "type": "object",
      "required": [
        "schema_version",
        "verifier",
        "independent",
        "verdict",
        "checked_at",
        "task_id",
        "attempt_id",
        "fencing_token",
        "lease_owner",
        "node_id",
        "agent_id",
        "result_reference",
        "result_sha256",
        "binding_sha256",
        "checks",
        "failed_checks"
      ],
      "properties": {
        "schema_version": { "const": "kolibri.control-plane-completion-verifier.v1" },
        "verifier": { "const": "control-plane/home" },
        "independent": { "const": true },
        "verdict": { "enum": ["passed", "failed"] },
        "checked_at": { "$ref": "#/$defs/Timestamp" },
        "task_id": { "$ref": "#/$defs/Identifier" },
        "attempt_id": { "$ref": "#/$defs/Identifier" },
        "fencing_token": { "type": "integer", "minimum": 1 },
        "lease_owner": { "type": "string", "minLength": 3 },
        "node_id": { "$ref": "#/$defs/Identifier" },
        "agent_id": { "$ref": "#/$defs/Identifier" },
        "result_reference": { "type": "string", "minLength": 1 },
        "result_sha256": { "$ref": "#/$defs/Sha256" },
        "binding_sha256": { "$ref": "#/$defs/Sha256" },
        "checks": { "$ref": "#/$defs/CompletionChecks" },
        "failed_checks": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "Task": {
      "type": "object",
      "required": [
        "task_id",
        "idempotency_key",
        "kind",
        "state",
        "attempt",
        "max_attempts",
        "attempt_id",
        "lease_fencing_schema",
        "fencing_token",
        "lease_owner",
        "lease_until",
        "heartbeat_at",
        "result_reference",
        "result",
        "error_type",
        "error",
        "created_at",
        "updated_at",
        "envelope"
      ],
      "properties": {
        "task_id": { "$ref": "#/$defs/Identifier" },
        "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 300 },
        "kind": { "type": "string", "minLength": 1 },
        "state": { "$ref": "#/$defs/TaskState" },
        "attempt": { "type": "integer", "minimum": 0 },
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 100 },
        "attempt_id": { "anyOf": [{ "$ref": "#/$defs/Identifier" }, { "type": "null" }] },
        "lease_fencing_schema": { "const": "kolibri.lease-fencing.v1" },
        "fencing_token": { "type": "integer", "minimum": 0 },
        "lease_owner": { "type": ["string", "null"] },
        "lease_until": { "type": ["number", "null"] },
        "heartbeat_at": { "anyOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] },
        "result_reference": { "type": ["string", "null"] },
        "result": { "type": ["object", "null"] },
        "completion_evidence": { "$ref": "#/$defs/TaskCompletionEvidence" },
        "completion_verifier": { "$ref": "#/$defs/TaskCompletionVerifier" },
        "error_type": { "type": ["string", "null"] },
        "error": { "type": ["string", "null"] },
        "created_at": { "$ref": "#/$defs/Timestamp" },
        "updated_at": { "$ref": "#/$defs/Timestamp" },
        "envelope": { "type": "object", "additionalProperties": true }
      },
      "allOf": [
        {
          "if": {
            "properties": { "state": { "enum": ["leased", "running", "waiting_review", "review"] } },
            "required": ["state"]
          },
          "then": {
            "required": ["attempt_id", "lease_owner", "lease_until"],
            "properties": {
              "attempt": { "type": "integer", "minimum": 1 },
              "attempt_id": { "$ref": "#/$defs/Identifier" },
              "fencing_token": { "type": "integer", "minimum": 1 },
              "lease_owner": { "type": "string", "minLength": 3 },
              "lease_until": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        },
        {
          "if": {
            "properties": { "state": { "const": "completed" } },
            "required": ["state"]
          },
          "then": {
            "required": ["result", "result_reference", "completion_evidence", "completion_verifier"],
            "properties": {
              "result": { "type": "object", "minProperties": 1 },
              "result_reference": { "type": "string", "minLength": 1 },
              "completion_verifier": {
                "allOf": [
                  { "$ref": "#/$defs/TaskCompletionVerifier" },
                  { "properties": { "verdict": { "const": "passed" } } }
                ]
              }
            }
          }
        }
      ],
      "additionalProperties": true,
      "x-kolibri-authority": "control-plane/home",
      "x-kolibri-legacy-fencing": "persisted pre-migration records may be read, but every new or re-leased task uses kolibri.lease-fencing.v1"
    },
    "TaskCreateRequest": {
      "type": "object",
      "required": ["idempotency_key", "kind"],
      "properties": {
        "task_id": { "$ref": "#/$defs/Identifier" },
        "idempotency_key": { "type": "string", "minLength": 8, "maxLength": 300 },
        "kind": { "type": "string", "minLength": 1 },
        "trace_id": { "$ref": "#/$defs/Identifier" },
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 100 },
        "max_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99,
          "deprecated": true,
          "description": "Two-wave input alias only. It means max_attempts = max_retries + 1 and conflicting fields are rejected."
        },
        "target_node": { "$ref": "#/$defs/Identifier" },
        "required_capability": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true,
      "x-kolibri-authority": "control-plane/home"
    },
    "TaskLeaseRequest": {
      "type": "object",
      "required": ["node_id", "agent_id", "capabilities"],
      "properties": {
        "node_id": { "$ref": "#/$defs/Identifier" },
        "agent_id": { "$ref": "#/$defs/Identifier" },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "runners": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true,
      "x-kolibri-result": "HTTP 200 returns one Home-issued fenced Task; HTTP 204 means no eligible work and is not a success proof"
    },
    "PublicProgress": {
      "type": "object",
      "required": ["schema_version", "type", "sequence", "delta"],
      "properties": {
        "schema_version": { "const": "kolibri.public-progress.v1" },
        "type": { "const": "reasoning_summary_delta" },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "delta": { "type": "string", "minLength": 1, "maxLength": 16384 }
      },
      "additionalProperties": false
    },
    "TaskHeartbeatRequest": {
      "allOf": [
        { "$ref": "#/$defs/LeaseFencing" },
        {
          "type": "object",
          "properties": {
            "state": { "enum": ["leased", "running", "review"] },
            "progress": { "$ref": "#/$defs/PublicProgress" },
            "pid": { "type": ["integer", "null"], "minimum": 1 },
            "worktree": { "type": ["string", "null"] },
            "branch": { "type": ["string", "null"] },
            "log_paths": {
              "type": ["object", "null"],
              "additionalProperties": { "type": "string" }
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "TaskCompletionRequest": {
      "allOf": [
        { "$ref": "#/$defs/LeaseFencing" },
        {
          "type": "object",
          "required": ["result_reference", "result"],
          "properties": {
            "task_id": { "$ref": "#/$defs/Identifier" },
            "result_reference": { "type": "string", "minLength": 1 },
            "result": {
              "type": "object",
              "minProperties": 1,
              "required": ["status", "fencing_token"],
              "properties": {
                "status": { "enum": ["completed", "healthy", "ok", "passed", "ready", "success"] },
                "fencing_token": { "type": "integer", "minimum": 1 }
              },
              "additionalProperties": true
            },
            "result_sha256": { "$ref": "#/$defs/Sha256" },
            "binding_sha256": { "$ref": "#/$defs/Sha256" }
          },
          "additionalProperties": true,
          "x-kolibri-equality-binding": "task_id, attempt_id, fencing_token, node_id and agent_id must bind the request, result and active lease"
        }
      ]
    },
    "TaskFailureRequest": {
      "allOf": [
        { "$ref": "#/$defs/LeaseFencing" },
        {
          "type": "object",
          "required": ["error_type"],
          "properties": {
            "error_type": { "type": "string", "minLength": 1 },
            "error": { "type": "string" },
            "retry": { "type": "boolean", "default": true },
            "result_reference": { "type": ["string", "null"] },
            "result": { "type": ["object", "null"] }
          },
          "additionalProperties": true
        }
      ]
    },
    "TaskCancelRequest": {
      "type": "object",
      "properties": {
        "reason": { "type": "string", "maxLength": 2000 },
        "cancelled_by": { "type": "string", "maxLength": 200 }
      },
      "additionalProperties": true,
      "x-kolibri-authority": "owner or authenticated Home control principal"
    },
    "TaskList": {
      "type": "object",
      "required": ["tasks", "queue", "pagination", "queue_total"],
      "properties": {
        "tasks": { "type": "array", "items": { "$ref": "#/$defs/Task" } },
        "queue": { "type": "array", "items": { "$ref": "#/$defs/Identifier" } },
        "pagination": {
          "type": "object",
          "required": ["limit", "offset", "returned", "total_indexed"],
          "properties": {
            "limit": { "type": "integer", "minimum": 1, "maximum": 250 },
            "offset": { "type": "integer", "minimum": 0 },
            "returned": { "type": "integer", "minimum": 0 },
            "total_indexed": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "queue_total": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "TaskCompletionResult": {
      "type": "object",
      "required": ["task", "review_task"],
      "properties": {
        "task": { "$ref": "#/$defs/Task" },
        "review_task": {
          "anyOf": [{ "$ref": "#/$defs/Task" }, { "type": "null" }]
        }
      },
      "additionalProperties": false
    },
    "LeaseFenceRejected": {
      "type": "object",
      "required": ["error", "reason", "task_id", "state", "attempt_id", "fencing_token"],
      "properties": {
        "error": { "const": "lease_fence_rejected" },
        "reason": {
          "enum": [
            "attempt_id_mismatch",
            "lease_fencing_schema_invalid",
            "fencing_token_invalid",
            "fencing_token_missing",
            "fencing_token_mismatch",
            "lease_node_mismatch",
            "lease_agent_mismatch"
          ]
        },
        "task_id": { "$ref": "#/$defs/Identifier" },
        "state": { "$ref": "#/$defs/TaskState" },
        "attempt_id": { "type": ["string", "null"] },
        "fencing_token": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "CompletionVerificationRejected": {
      "type": "object",
      "required": ["error", "task_id", "state", "verifier"],
      "properties": {
        "error": { "const": "completion_verification_failed" },
        "task_id": { "$ref": "#/$defs/Identifier" },
        "state": { "$ref": "#/$defs/TaskState" },
        "verifier": {
          "allOf": [
            { "$ref": "#/$defs/TaskCompletionVerifier" },
            { "properties": { "verdict": { "const": "failed" } } }
          ]
        }
      },
      "additionalProperties": false
    },
    "CapabilityExecutionProof": {
      "type": "object",
      "required": ["state"],
      "properties": {
        "state": { "enum": ["not_run", "failed", "verified"] },
        "verified_at": { "anyOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] },
        "task_id": { "type": ["string", "null"] },
        "artifact_sha256": { "anyOf": [{ "$ref": "#/$defs/Sha256" }, { "type": "null" }] },
        "verifier_binding_sha256": { "anyOf": [{ "$ref": "#/$defs/Sha256" }, { "type": "null" }] }
      },
      "additionalProperties": false,
      "x-kolibri-truth-rule": "declared or available runner metadata is never execution proof"
    },
    "CapabilityObservation": {
      "type": "object",
      "required": ["capability", "declared", "probe_status", "execution_proof"],
      "properties": {
        "capability": { "type": "string", "minLength": 1 },
        "declared": { "type": "boolean" },
        "probe_status": { "enum": ["not_run", "passed", "failed", "blocked"] },
        "execution_proof": { "$ref": "#/$defs/CapabilityExecutionProof" }
      },
      "additionalProperties": false
    },
    "NodeRecord": {
      "type": "object",
      "required": ["node_id", "capabilities", "health", "heartbeat_at"],
      "properties": {
        "node_id": { "$ref": "#/$defs/Identifier" },
        "agent_id": { "type": ["string", "null"] },
        "hostname": { "type": ["string", "null"] },
        "capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "capability_observations": { "type": "array", "items": { "$ref": "#/$defs/CapabilityObservation" } },
        "health": { "enum": ["online", "healthy", "ready", "degraded", "stale", "offline", "quarantined", "unknown"] },
        "heartbeat_at": { "anyOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] },
        "active_attempts": {
          "type": ["array", "null"],
          "items": { "$ref": "#/$defs/TaskAttempt" },
          "x-kolibri-null-means": "unknown bootstrap observation; never zero active work and never execution proof"
        }
      },
      "additionalProperties": true,
      "x-kolibri-membership-authority": "signed mesh manifest; Redis cards are observations only"
    },
    "NodeRegistrationRequest": {
      "type": "object",
      "required": ["node_id", "agent_id", "capabilities"],
      "properties": {
        "node_id": { "$ref": "#/$defs/Identifier" },
        "agent_id": { "$ref": "#/$defs/Identifier" },
        "hostname": { "type": ["string", "null"] },
        "capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "runners": { "type": "object", "additionalProperties": true },
        "runner_readiness": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "NodeHeartbeatRequest": {
      "type": "object",
      "properties": {
        "node_id": { "$ref": "#/$defs/Identifier" },
        "agent_id": { "$ref": "#/$defs/Identifier" },
        "capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "runners": { "type": "object", "additionalProperties": true },
        "runner_readiness": { "type": "object", "additionalProperties": true },
        "active_attempts": {
          "type": ["array", "null"],
          "items": { "$ref": "#/$defs/TaskAttempt" }
        }
      },
      "additionalProperties": true,
      "x-kolibri-truth-rule": "heartbeat proves freshness only; active_attempts null is unknown and runner availability is not invocation proof"
    }
  }
}
