        "tags": ["learning"],
        "operationId": "transitionLearningModelRegistry",
        "parameters": [{ "$ref": "#/components/parameters/LearningRegistryId" }],
        "requestBody": { "$ref": "#/components/requestBodies/Mutation" },
        "responses": { "200": { "$ref": "#/components/responses/Success" } },
        "x-kolibri-state-machine": "shadow -> canary-1 -> canary-10 -> canary-50 -> production; explicit rollback",
        "x-kolibri-runtime-traffic-mutated": false,
        "x-kolibri-production-weight-mutation": false,
        "x-kolibri-implementation": "compatibility"
      }
    },
    "/v1/automations": {
      "get": {
        "tags": ["automations"],
        "operationId": "listAutomations",
        "responses": { "200": { "$ref": "#/components/responses/Success" } },
        "x-kolibri-implementation": "target"
      },
      "post": {
        "tags": ["automations"],
        "operationId": "createAutomation",
        "requestBody": { "$ref": "#/components/requestBodies/Mutation" },
        "responses": { "201": { "$ref": "#/components/responses/Success" } },
        "x-kolibri-schema": "domain.schema.json#/$defs/Automation",
        "x-kolibri-implementation": "target"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque Kolibri API key",
        "description": "Required for durable execution, project, artifact, learning and owner-control data. The API fails closed when no server credential is configured."
      },
      "PublicSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "kolibri_public_session",
        "description": "Short-lived opaque browser session, bound to exact Origin and an ephemeral project/response scope."
      }
    },
    "parameters": {
      "ProjectId": { "name": "project_id", "in": "path", "required": true, "schema": { "type": "string" } },
      "WorkstreamId": { "name": "workstream_id", "in": "path", "required": true, "schema": { "type": "string" } },
      "ResponseId": { "name": "response_id", "in": "path", "required": true, "schema": { "type": "string" } },
      "LearningIntakeId": { "name": "intake_id", "in": "path", "required": true, "schema": { "type": "string" } },
      "LearningCandidateId": { "name": "candidate_id", "in": "path", "required": true, "schema": { "type": "string" } },
      "LearningDatasetId": { "name": "dataset_id", "in": "path", "required": true, "schema": { "type": "string" } },
      "LearningRegistryId": { "name": "registry_id", "in": "path", "required": true, "schema": { "type": "string" } },
      "TaskId": { "name": "task_id", "in": "path", "required": true, "schema": { "type": "string" } },
      "ApprovalId": { "name": "approval_id", "in": "path", "required": true, "schema": { "type": "string" } },
      "ReleaseId": { "name": "release_id", "in": "path", "required": true, "schema": { "type": "string" } },
      "NodeId": { "name": "node_id", "in": "path", "required": true, "schema": { "type": "string" } },
      "RefreshProbe": {
        "name": "refresh", "in": "query", "required": false,
        "schema": { "type": "boolean", "default": false },
        "description": "Bypass the short inventory cache, re-read safe metadata, and run read-only native-tool JSONL probes."
      }
    },
    "requestBodies": {
      "Mutation": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": { "idempotency_key": { "type": "string", "minLength": 8 } },
              "additionalProperties": true
            }
          }
        }
      }
    },
    "responses": {
      "Success": {
        "description": "Versioned durable response",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } }
      },
      "Accepted": {
        "description": "Accepted into durable scheduling; not a completion claim",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } }
      },
      "CapabilityList": {
        "description": "Truthful runtime-probed capability inventory",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CapabilityList" } } }
      }
    },
    "schemas": {
      "ResponseCreate": {
        "type": "object",
        "required": ["model", "input"],
        "properties": {
          "model": { "const": "kolibri" },
          "input": {
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "type": "object", "additionalProperties": true } }
            ]
          },
          "stream": { "type": "boolean", "default": false },
          "previous_response_id": { "type": ["string", "null"] },
          "execution_mode": { "type": "string", "enum": ["fast", "codex"], "default": "fast" },
          "task": { "type": ["object", "null"], "additionalProperties": true },
          "tools": {
            "type": "array",
            "maxItems": 16,
            "items": { "type": "object", "additionalProperties": true },
            "description": "Validated capability declarations. web_search/web_search_preview execute through the controlled HTTP gateway; project_knowledge executes only for an authenticated owner through the bounded repository index gateway."
          },
          "idempotency_key": { "type": ["string", "null"], "maxLength": 300 }
        },
        "additionalProperties": true
      },
      "Envelope": {
        "type": "object",
        "required": ["schema_version"],
        "properties": {
          "schema_version": { "type": "string" },
          "id": { "type": "string" },
          "status": { "type": "string" },
          "trace_id": { "type": "string" }
        },
        "additionalProperties": true
      },
      "CapabilityRecord": {
        "type": "object",
        "required": ["id", "object", "kind", "name", "status", "availability_reason", "invocable", "source"],
        "properties": {
          "id": { "type": "string" },
          "object": { "const": "capability" },
          "kind": { "enum": ["capability", "plugin", "skill", "tool"] },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "status": { "enum": ["available", "degraded", "unavailable"] },
          "availability_reason": { "type": "string" },
          "invocable": { "type": "boolean" },
          "native_tool": { "type": "boolean" },
          "read_only": { "type": "boolean" },
          "event_aliases": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "runtime_probe": {
            "type": "object",
            "required": ["status", "reason", "observed_event_types", "observed_tool_names", "tool_event_count", "verifier_verdict"],
            "properties": {
              "status": { "enum": ["available", "degraded", "unavailable"] },
              "reason": { "type": "string" },
              "observed_event_types": { "type": "array", "items": { "type": "string" } },
              "observed_tool_names": { "type": "array", "items": { "type": "string" } },
              "tool_event_count": { "type": "integer", "minimum": 0 },
              "verifier_verdict": { "enum": ["not_run", "passed", "failed"] },
              "evidence_binding_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "error_types": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          },
          "source": {
            "type": "object",
            "required": ["type", "manifest_sha256"],
            "properties": {
              "type": { "type": "string" },
              "manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "CapabilityList": {
        "type": "object",
        "required": ["schema_version", "object", "status", "data", "summary", "probes"],
        "properties": {
          "schema_version": { "const": "kolibri.capabilities.v1" },
          "object": { "const": "list" },
          "status": { "enum": ["available", "degraded", "unavailable"] },
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/CapabilityRecord" } },
          "summary": {
            "type": "object",
            "required": ["total", "available", "degraded", "unavailable"],
            "additionalProperties": { "type": "integer", "minimum": 0 }
          },
          "probes": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
        },
        "additionalProperties": false
      }
    }
  }
}
