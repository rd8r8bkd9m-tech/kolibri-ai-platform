{
  "openapi": "3.1.0",
  "info": {
    "title": "Kolibri AI OS API",
    "version": "1.0.0-contract-freeze",
    "description": "Frozen public and owner-control surface. A listed operation is a compatibility target, not a production rollout claim."
  },
  "servers": [
    { "url": "https://kolibriai.ru", "description": "Public shell and same-origin API" }
  ],
  "security": [
    { "BearerAuth": [] }
  ],
  "tags": [
    { "name": "responses" },
    { "name": "continuity" },
    { "name": "execution" },
    { "name": "runtime" },
    { "name": "canvas" },
    { "name": "documents" },
    { "name": "automations" },
    { "name": "learning" },
    { "name": "owner-control" }
  ],
  "paths": {
    "/v1/shell/bootstrap": {
      "post": {
        "tags": ["responses"],
        "operationId": "bootstrapShell",
        "security": [],
        "responses": { "200": { "$ref": "#/components/responses/Success" } },
        "x-kolibri-session": "atomic POST-first create-or-resume; exact-origin HttpOnly SameSite=Strict; only token SHA-256 is stored",
        "x-kolibri-rule": "cold browser startup never depends on an expected 401/403 GET"
      }
    },
    "/v1/public/session": {
      "post": {
        "tags": ["responses"],
        "operationId": "createPublicSession",
        "security": [],
        "responses": { "200": { "$ref": "#/components/responses/Success" } },
        "x-kolibri-session": "compatibility alias for POST /v1/shell/bootstrap; short-lived same-origin HttpOnly SameSite=Strict; only token SHA-256 is stored"
      },
      "get": {
        "tags": ["responses"],
        "operationId": "getPublicSession",
        "security": [{ "PublicSession": [] }],
        "responses": { "200": { "$ref": "#/components/responses/Success" } }
      }
    },
    "/v1/responses": {
      "post": {
        "tags": ["responses"],
        "operationId": "createResponse",
        "security": [{ "BearerAuth": [] }, { "PublicSession": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResponseCreate" } } }
        },
        "responses": {
          "200": {
            "description": "OpenAI-compatible Response JSON or typed Responses SSE",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } },
              "text/event-stream": { "schema": { "type": "string" } }
            }
          },
          "201": { "$ref": "#/components/responses/Success" }
        },
        "x-kolibri-provider-selection": "server-policy-only",
        "x-kolibri-tool-completion-gate": "non-empty answer plus provider evidence plus deterministic verifier evidence",
        "x-kolibri-public-session-tool-scope": "only response-scoped tool:web_search through the controlled allowlisted HTTP gateway; tool:project_knowledge is owner-only; no shell or generic URL fetch",
        "x-kolibri-owner-project-knowledge": "bounded allowlisted repository evidence with path, line span, file/span SHA-256 and mandatory citations; no symlinks, secrets, runtime artifacts or wildcard filesystem access",
        "x-kolibri-implementation": "compatibility"
      }
    },
    "/v1/responses/{response_id}": {
      "get": {
        "tags": ["responses"],
        "operationId": "getResponse",
        "security": [{ "BearerAuth": [] }, { "PublicSession": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ResponseId" }],
        "responses": { "200": { "$ref": "#/components/responses/Success" } },
        "x-kolibri-implementation": "compatibility"
      }
    },
    "/v1/responses/{response_id}/cancel": {
      "post": {
        "tags": ["responses"],
        "operationId": "cancelResponse",
        "security": [{ "BearerAuth": [] }, { "PublicSession": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ResponseId" }],
        "responses": { "200": { "$ref": "#/components/responses/Success" } },
        "x-kolibri-implementation": "compatibility"
      }
    },
    "/v1/responses/{response_id}/events": {
      "get": {
        "tags": ["responses"],
        "operationId": "streamResponseEvents",
        "parameters": [{ "$ref": "#/components/parameters/ResponseId" }],
        "responses": {
          "200": {
            "description": "Server-sent response events or a JSON snapshot when SSE is not requested",
            "content": {
              "text/event-stream": { "schema": { "type": "string" } },
              "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } }
