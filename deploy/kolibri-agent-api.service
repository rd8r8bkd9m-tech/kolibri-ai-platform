[Unit]
Description=Kolibri Agent API
After=network.target

[Service]
Type=simple
Environment=KOLIBRI_AGENT_KEY=change-me
Environment=KOLIBRI_NODE_ID=agent-01
Environment=KOLIBRI_CONTROL_URL=http://10.99.0.1:9101
ExecStart=/usr/local/bin/mimo serve --port 8001 --api-key $KOLIBRI_AGENT_KEY
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
