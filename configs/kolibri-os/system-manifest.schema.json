{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kolibriai.ru/schemas/system-manifest.schema.json",
  "type": "object",
  "required": ["version", "product", "public_model", "authority", "ux", "api", "capability_gate", "factory", "rust", "formulalm", "release_gates"],
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "product": {"const": "Kolibri AI OS"},
    "public_model": {"const": "kolibri"},
    "authority": {"type": "object", "required": ["control_plane"], "properties": {"control_plane": {"const": "home"}}},
    "ux": {"type": "object", "required": ["direction", "single_project_conversation"], "properties": {"direction": {"const": "morphing_conversation"}, "single_project_conversation": {"const": true}, "permanent_vertical_menu": {"const": false}, "single_bird_per_surface": {"const": true}}},
    "api": {"type": "object", "required": ["base", "openai_compatible", "public_model"], "properties": {"base": {"const": "/v1"}, "openai_compatible": {"const": true}, "public_model": {"const": "kolibri"}}},
    "capability_gate": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string"}},
    "factory": {"type": "object"},
    "rust": {"type": "object"},
    "formulalm": {"type": "object"},
    "release_gates": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": true
}
