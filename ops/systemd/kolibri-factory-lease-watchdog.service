[Unit]
Description=Kolibri Factory lease and stuck-task watchdog (Home authority only)
After=network-online.target kolibri-factory-control.service
Wants=network-online.target
ConditionPathExists=/var/lib/kolibri-mesh/peers.json

[Service]
Type=oneshot
User=root
EnvironmentFile=-/etc/kolibri/telegram.env
Environment=KOLIBRI_MESH_MEMBERSHIP_MANIFEST=/var/lib/kolibri-mesh/peers.json
Environment=KOLIBRI_FACTORY_WATCHDOG_LIMIT=50
Environment=KOLIBRI_FACTORY_WATCHDOG_STALE_AFTER=3600
Environment=KOLIBRI_FACTORY_WATCHDOG_TIMEOUT=20
Environment=TELEGRAM_GATEWAY_STATE=/var/lib/kolibri-telegram-gateway/state.json
ExecStartPre=/usr/bin/python3 /usr/local/lib/kolibri/control_plane_endpoint.py --assert-local-home
ExecStartPre=/usr/bin/python3 /usr/local/lib/kolibri/control_plane_endpoint.py --print-url --control-url http://127.0.0.1:9101
ExecStart=/usr/local/bin/kolibri-factory-lease-watchdog --control-url http://127.0.0.1:9101 --telegram-on-action
Nice=5

[Install]
WantedBy=multi-user.target
