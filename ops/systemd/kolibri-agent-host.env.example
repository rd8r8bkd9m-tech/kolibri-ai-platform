# Kolibri Factory Agent Host standard profile.
# Copy to /etc/kolibri-agent-host.env or let ops/bootstrap_factory_node.sh generate it.
# Keep secrets out of this file; inject OPENAI_API_KEY and repository credentials with
# your secret manager or a separate root-readable systemd drop-in.

# Control Plane endpoints. KOLIBRI_FACTORY_CONTROL_URLS is a comma-separated failover
# list; the first URL is used as the primary.
KOLIBRI_FACTORY_CONTROL_URL="http://10.99.0.2:9101"
KOLIBRI_FACTORY_CONTROL_URLS="http://10.99.0.2:9101"

# Omit these to use the bootstrap-generated stable node id and default agent id.
# KOLIBRI_NODE_ID="factory-node-001"
# KOLIBRI_AGENT_ID="factory-node-001-agent-host"

# Standard full-autonomy factory node capability profile.
KOLIBRI_AGENT_CAPABILITIES="read_only_probe,generic_implementation,review,image_generation,mesh_node,permission:*"
KOLIBRI_AGENT_PERMISSIONS="*"
KOLIBRI_AGENT_PERMISSION_PACKS="full_autonomy"

# Throughput and lease/heartbeat tuning.
KOLIBRI_MAX_INFLIGHT="1"
KOLIBRI_HEARTBEAT_INTERVAL="10"
KOLIBRI_LEASE_REFRESH="20"

# Runtime roots are local to each node.
KOLIBRI_AGENT_WORK_ROOT="/var/lib/kolibri-agent/worktrees"
KOLIBRI_AGENT_ARTIFACT_ROOT="/var/lib/kolibri-agent/artifacts"

# Repository cloned by implementation/review tasks.
KOLIBRI_REPO_URL="https://github.com/rd8r8bkd9m-tech/kolibri-ai-platform.git"

# Image task defaults. Do not put OPENAI_API_KEY here.
KOLIBRI_IMAGE_MODEL="gpt-image-1"
KOLIBRI_IMAGE_SIZE="1024x1024"
KOLIBRI_IMAGE_OUTPUT_FORMAT="png"

# Codex CLI automation. Do not put CODEX_ACCESS_TOKEN here; use a secret manager
# or a root-readable token file referenced by KOLIBRI_CODEX_ACCESS_TOKEN_FILE.
KOLIBRI_CODEX_AUTH_MODE="access_token"
KOLIBRI_CODEX_HOME="/var/lib/kolibri-agent/.codex"
KOLIBRI_CODEX_INSTALL_CMD="npm install -g @openai/codex@latest"
# KOLIBRI_CODEX_ACCESS_TOKEN_FILE="/run/secrets/codex_access_token"
