[Unit]
Description=Kolibri persistent Agent Host
After=network-online.target kolibri-mesh-registry.service
Wants=network-online.target kolibri-mesh-registry.service

[Service]
Type=simple
User=kolibri-agent
Group=kolibri-agent
EnvironmentFile=/etc/kolibri-agent-host.env
Environment=KOLIBRI_MESH_MEMBERSHIP_MANIFEST=/var/lib/kolibri-mesh/peers.json
Environment=KOLIBRI_RUNNER_ACCESS_MANIFEST=/etc/kolibri/runner-access.json
Environment=KOLIBRI_ARTIFACT_ROOT=/var/lib/kolibri-agent/artifacts
Environment=KOLIBRI_RELEASE_HELPER_SOCKET=/run/kolibri-release/installer.sock
Environment=PYTHONPATH=/usr/local/lib/kolibri
Environment=HOME=/var/lib/kolibri-agent
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=+/usr/bin/chgrp kolibri-agent /var/lib/kolibri-mesh/peers.json
ExecStartPre=+/usr/bin/chmod 0640 /var/lib/kolibri-mesh/peers.json
ExecStart=/usr/bin/python3 -B /usr/local/bin/kolibri-agent-host
Restart=always
RestartSec=5
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kolibri-agent /var/lib/kolibri-mesh/peers.json
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
