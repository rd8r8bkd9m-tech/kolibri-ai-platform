[Unit]
Description=Kolibri privileged release helper socket

[Socket]
ListenStream=/run/kolibri-release/installer.sock
SocketUser=root
SocketGroup=kolibri-agent
SocketMode=0660
# The socket remains 0660/root:kolibri-agent. The parent only grants path
# traversal; 0750 root:root prevents the allowed worker user from reaching the
# socket at all when systemd creates a fresh /run directory.
DirectoryMode=0755
RemoveOnStop=true

[Install]
WantedBy=sockets.target
