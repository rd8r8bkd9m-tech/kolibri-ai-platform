[Unit]
Description=Kolibri Telegram Factory Gateway
After=network-online.target kolibri-mesh-registry.service kolibri-factory-control.service
Wants=network-online.target kolibri-mesh-registry.service
ConditionPathExists=/var/lib/kolibri-mesh/peers.json

[Service]
Type=simple
User=kolibri
Group=kolibri
EnvironmentFile=/etc/kolibri/telegram.env
Environment=KOLIBRI_MESH_MEMBERSHIP_MANIFEST=/var/lib/kolibri-mesh/peers.json
Environment=TELEGRAM_GATEWAY_STATE=/var/lib/kolibri-telegram-gateway/state.json
Environment=TELEGRAM_UPDATE_RECEIVER=polling
Environment=HTTPS_PROXY=http://127.0.0.1:18080
WorkingDirectory=/usr/local/lib/kolibri
ExecStartPre=/usr/bin/python3 /usr/local/lib/kolibri/control_plane_endpoint.py --assert-local-home
ExecStart=/usr/bin/python3 /usr/local/lib/kolibri/telegram_gateway.py
Restart=always
RestartSec=5
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
