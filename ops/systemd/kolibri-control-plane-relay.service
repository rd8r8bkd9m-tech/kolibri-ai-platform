[Unit]
Description=Kolibri node-local Control Plane relay
After=network-online.target wg-quick@wg-kolibri.service
Wants=network-online.target
Requires=wg-quick@wg-kolibri.service

[Service]
Type=simple
EnvironmentFile=/etc/kolibri-control-plane-relay.env
ExecStart=/usr/local/bin/kolibri-control-plane-relay
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
