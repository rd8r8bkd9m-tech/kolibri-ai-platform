[Unit]
Description=Kolibri loopback Codex image worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ladik
Group=ladik
WorkingDirectory=__KOLIBRI_BACKEND_DIR__
EnvironmentFile=/etc/kolibri/backend.env
EnvironmentFile=/etc/kolibri/codex-cli/proxy.env
EnvironmentFile=/etc/kolibri/codex-cli.env
Environment=HOME=/home/ladik
Environment=CODEX_HOME=__KOLIBRI_STATE_DIR__/codex-home
Environment=CODEX_CLI_MODEL=
Environment=CODEX_CLI_IMAGE_MODEL=
Environment=CODEX_CLI_IMAGE_ENABLED=true
Environment=CODEX_CLI_IMAGE_TEMP_ROOT=__KOLIBRI_STATE_DIR__/tmp
Environment=CODEX_CLI_IMAGE_TIMEOUT_SECONDS=600
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=__KOLIBRI_PYTHON__ -m uvicorn app.codex_image_worker:app --host 127.0.0.1 --port 18016
Restart=on-failure
RestartSec=3
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__KOLIBRI_STATE_DIR__
BindReadOnlyPaths=/home/ladik/.codex/auth.json:__KOLIBRI_STATE_DIR__/codex-home/auth.json

[Install]
WantedBy=multi-user.target
