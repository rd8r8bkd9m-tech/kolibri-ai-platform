{
  "schema_version": "kolibri.runner-access.v1",
  "authority": "home",
  "node_selector": "dynamic-membership",
  "runners": {
    "codex": {
      "mode": "local_service_account",
      "authorization_flow": "browser_device",
      "identity_ref": "service-user://home-owner",
      "probe": {
        "model": "gpt-5.5",
        "sandbox": "read-only",
        "timeout_seconds": 45
      }
    },
    "mimo": {
      "mode": "disabled"
    }
  }
}
