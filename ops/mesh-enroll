#!/bin/sh
set -eu

# Keep the established command surface used by bootstrap, but delegate JSON,
# authentication, validation and network I/O to the audited Python registry.
REGISTRY_IMPL=${KOLIBRI_MESH_REGISTRY_IMPL:-/usr/local/lib/kolibri/mesh_registry.py}
exec /usr/bin/python3 "$REGISTRY_IMPL" client "$@"
