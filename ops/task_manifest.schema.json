{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kolibri.local/schemas/task_manifest.schema.json",
  "title": "Kolibri Mimo Agent Task Manifest",
  "type": "object",
  "required": [
    "task_id",
    "server",
    "mode",
    "prompt",
    "worktree",
    "allowed_paths",
    "quality_contract",
    "required_checks",
    "timeout_seconds",
    "secrets_policy",
    "expected_output"
  ],
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,80}$"
    },
    "agent_role": {
      "type": "string"
    },
    "server": {
      "type": "string",
      "description": "Server key from ops/agents.yml, or local."
    },
    "mode": {
      "type": "string",
      "enum": ["read_only", "controlled_mutation", "health", "report"]
    },
    "prompt": {
      "type": "string",
      "minLength": 20
    },
    "worktree": {
      "type": "string",
      "minLength": 1
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "not": {
          "pattern": "(^|/|\\\\)(\\.env|\\.ssh|\\.mimocode|auth\\.json)(/|\\\\|$)"
        }
      }
    },
    "forbidden_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [".env", ".ssh", ".mimocode", "auth.json"]
    },
    "quality_contract": {
      "type": "object",
      "required": [
        "objective",
        "context",
        "scope",
        "out_of_scope",
        "acceptance_criteria",
        "verification_steps",
        "deliverables",
        "stop_conditions"
      ],
      "additionalProperties": false,
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 20
        },
        "context": {
          "type": "string",
          "minLength": 20
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "out_of_scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 8
          }
        },
        "verification_steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "deliverables": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "stop_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 8
          }
        }
      }
    },
    "required_checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 3600
    },
    "model": {
      "type": "string",
      "default": "mimo/mimo-auto"
    },
    "allow_unsafe_permissions": {
      "type": "boolean",
      "default": false,
      "const": false
    },
    "secrets_policy": {
      "type": "object",
      "required": ["allow_env_files", "allow_auth_files", "redact_logs"],
      "additionalProperties": false,
      "properties": {
        "allow_env_files": {
          "type": "boolean",
          "const": false
        },
        "allow_auth_files": {
          "type": "boolean",
          "const": false
        },
        "redact_logs": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "expected_output": {
      "type": "object",
      "required": ["format", "requires_summary"],
      "properties": {
        "format": {
          "type": "string",
          "const": "structured_result"
        },
        "requires_summary": {
          "type": "boolean",
          "const": true
        },
        "requires_changed_files": {
          "type": "boolean",
          "default": true
        },
        "requires_risks": {
          "type": "boolean",
          "default": true
        }
      }
    }
  }
}
