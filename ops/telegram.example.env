# Example environment for scripts/telegram_task_gateway.py.
# Copy values into your runtime environment or service manager.
# Do not commit real tokens or production secrets.

# Telegram bot token from BotFather. Leave blank in this example.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram numeric user IDs allowed to use the gateway.
# The gateway refuses to start without at least one allowlisted user.
KOLIBRI_TELEGRAM_ALLOWED_USER_IDS=123456789

# Queue and log paths. Relative paths are resolved from the repo root.
KOLIBRI_TELEGRAM_QUEUE_DIR=ops/tasks/telegram-queue
KOLIBRI_TELEGRAM_LOG_DIR=logs/agent-runs

# Runner and default manifest target. The gateway only calls validate/report.
KOLIBRI_TELEGRAM_RUNNER=scripts/mimo_task_runner.py
KOLIBRI_TELEGRAM_DEFAULT_SERVER=local
KOLIBRI_TELEGRAM_DEFAULT_WORKTREE=.

# Read-only Telegram tasks may inspect the project but must not mutate it.
KOLIBRI_TELEGRAM_READONLY_ALLOWED_PATHS=.

# Controlled mutation is queued only when /submit includes
# --controlled --approve-controlled-mutation. It is never executed by Telegram.
KOLIBRI_TELEGRAM_CONTROLLED_ALLOWED_PATHS=docs,scripts,ops/tasks
KOLIBRI_TELEGRAM_CONTROLLED_REQUIRED_CHECKS=python3 -m py_compile scripts/mimo_task_runner.py scripts/telegram_task_gateway.py

# Upper bound for stored task text.
KOLIBRI_TELEGRAM_MAX_TASK_CHARS=3000
