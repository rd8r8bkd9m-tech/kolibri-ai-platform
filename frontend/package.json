{
  "name": "vista-os-product",
  "private": true,
  "version": "11.1.0-product-release",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run --environment jsdom --pool=threads --no-fileParallelism --maxWorkers=1",
    "test:ci": "vitest run --environment jsdom --pool=threads --no-fileParallelism --maxWorkers=1 --coverage=false",
    "check": "npm run test:ci && npm run build"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.3",
    "vite": "8.1.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "jsdom": "29.1.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/jest-dom": "6.9.1"
  }
}
