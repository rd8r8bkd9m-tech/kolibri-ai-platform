{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Colibri Agent Role",
  "type": "object",
  "required": [
    "role_id",
    "name_ru",
    "name_en",
    "department",
    "description",
    "capabilities",
    "allowed_actions",
    "forbidden_actions",
    "inputs",
    "outputs",
    "required_artifacts",
    "verifier_requirements",
    "risk_level",
    "can_delegate",
    "can_modify_code",
    "can_access_runtime",
    "can_deploy",
    "human_approval_required"
  ],
  "properties": {
    "role_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "name_ru": {
      "type": "string"
    },
    "name_en": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "allowed_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verifier_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "can_delegate": {
      "type": "boolean"
    },
    "can_modify_code": {
      "type": "boolean"
    },
    "can_access_runtime": {
      "type": "boolean"
    },
    "can_deploy": {
      "type": "boolean"
    },
    "human_approval_required": {
      "type": "boolean"
    }
  }
}
