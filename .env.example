# Vista OS production environment
VISTA_ENV=production
VISTA_DB_PATH=/data/vista.db
VISTA_ARTIFACT_ROOT=/data/artifacts
VISTA_NODE_ID=control-01

# Required secrets. Generate each value independently:
#   openssl rand -hex 32
VISTA_SESSION_SECRET=replace-with-long-random-session-secret
VISTA_OWNER_ACCESS_TOKEN=replace-with-long-random-owner-token
VISTA_NODE_JOIN_TOKEN=replace-with-long-random-node-token
VISTA_NODE_SIGNING_SECRET=replace-with-long-random-node-signing-secret

# Public web origins allowed to call the API directly.
# The default Docker deployment uses same-origin /api through nginx.
VISTA_ALLOWED_ORIGINS=https://vista.example.com
VISTA_MAX_BODY_BYTES=26214400
VISTA_JSON_LOGS=1

# Factory runtime
VISTA_NODE_STALE_SECONDS=60
VISTA_TASK_MAX_ATTEMPTS=3

# OpenAI-compatible upstream gateway. The upstream secret never enters the browser.
# Vista project keys (vista_sk_live_...) authenticate SDK clients to /v1/*.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime
OPENAI_PROJECT=
OPENAI_ORGANIZATION=

# Used only when building the native Tauri desktop shell.
# Example: https://vista.example.com
VISTA_DESKTOP_API_BASE=https://vista.example.com
