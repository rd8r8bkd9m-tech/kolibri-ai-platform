KOLIBRI_ENV=production
KOLIBRI_DATA_DIR=/var/lib/kolibri
KOLIBRI_DB_PATH=/var/lib/kolibri/kolibri.db
KOLIBRI_ARTIFACT_DIR=/var/lib/kolibri/artifacts
KOLIBRI_SESSION_SECRET=replace-with-at-least-32-random-characters
KOLIBRI_NODE_JOIN_TOKEN=replace-with-random-node-token
KOLIBRI_OWNER_ACCESS_TOKEN=replace-with-owner-access-token
KOLIBRI_OPERATOR_ACCESS_TOKEN=replace-with-operator-access-token
KOLIBRI_DEVELOPER_ACCESS_TOKEN=replace-with-developer-access-token
KOLIBRI_EXPOSE_SESSION_TOKEN=0
KOLIBRI_ALLOWED_ORIGINS=https://kolibriai.ru
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# OpenAI-compatible developer API keys. Prefer a root-readable JSON file in production.
# Shape: {"sk-kolibri-...":{"role":"developer","name":"portal"}}
KOLIBRI_API_KEYS_FILE=
KOLIBRI_API_KEYS_JSON=

# Optional upstream provider scoping. Browser/client values are never forwarded.
OPENAI_PROJECT=
OPENAI_ORGANIZATION=
