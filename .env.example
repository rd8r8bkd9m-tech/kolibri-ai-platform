# Kolibri AI Platform Configuration
# Copy to .env and adjust values for your environment

# --- Security (REQUIRED for production) ---
KOLIBRI_JWT_SECRET=CHANGE-ME-TO-A-RANDOM-SECRET-STRING
KOLIBRI_JWT_ACCESS_EXPIRE_MINUTES=60
KOLIBRI_JWT_REFRESH_EXPIRE_DAYS=30

# --- CORS (comma-separated origins) ---
KOLIBRI_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://kolibri.ai

# --- Rate Limiting ---
KOLIBRI_RATE_LIMIT_REQUESTS=60
KOLIBRI_RATE_LIMIT_WINDOW=60

# --- Paths ---
KOLIBRI_DATA_DIR=/opt/kolibri-ai/data
KOLIBRI_FRONTEND_DIR=/opt/kolibri-ai/frontend/dist
KOLIBRI_TTS_DIR=/opt/kolibri-ai/data/tts
KOLIBRI_MIMO_BIN=/root/.mimocode/bin/mimo

# --- Internal Services (WireGuard IPs) ---
KOLIBRI_RAG_URL=http://10.99.0.3:8002
KOLIBRI_AGENT_URL=http://10.99.0.4:8003
KOLIBRI_INFERENCE_URL=http://10.99.0.5:8001
KOLIBRI_CLUSTER_URL=http://127.0.0.1:9001
