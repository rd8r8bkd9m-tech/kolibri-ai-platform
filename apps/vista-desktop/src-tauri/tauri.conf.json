{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vista OS",
  "version": "11.0.0",
  "identifier": "ru.kolibriai.vista",
  "build": {
    "beforeDevCommand": "npm --prefix ../../../frontend run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "../../../scripts/build-desktop-frontend.sh",
    "frontendDist": "../../../frontend/dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Vista OS",
      "width": 1440,
      "height": 900,
      "minWidth": 900,
      "minHeight": 640,
      "center": true,
      "resizable": true,
      "fullscreen": false,
      "decorations": true
    }],
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' http://127.0.0.1:* https: wss:; script-src 'self'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Adaptive AI operating workspace",
    "longDescription": "Vista OS is a single-window AI workspace for estimates, verified documents and controlled factory execution.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"]
  }
}
